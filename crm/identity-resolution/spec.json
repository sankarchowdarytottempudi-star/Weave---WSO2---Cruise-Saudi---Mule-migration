  "profiles": [
    {
      "name": "Identity Reviewer",
      "cloneFrom": "Standard",
      "permissions": {
        "Identity_Review_Cases": [
          "view",
          "edit"
        ],
        "Identity_Decision_History": [
          "view"
        ],
        "Guest_Identities": [
          "view"
        ],
        "Contacts": [
          "view"
        ]
      }
    },
    {
      "name": "Identity Supervisor",
      "cloneFrom": "Standard",
      "permissions": {
        "Identity_Review_Cases": [
          "view",
          "edit",
          "reassign"
        ],
        "Identity_Decision_History": [
          "view"
        ],
        "Guest_Identities": [
          "view"
        ],
        "Contacts": [
          "view"
        ]
      }
    },
    {
      "name": "Identity Audit",
      "cloneFrom": "Standard",
      "permissions": {
        "Identity_Review_Cases": [
          "view"
        ],
        "Identity_Decision_History": [
          "view"
        ],
        "Guest_Identities": [
          "view"
        ],
        "Contacts": [
          "view"
        ]
      }
    }
  ],
  "webhooks": [
    {
      "name": "Identity_Reevaluation_Requested",
      "module": "Contacts",
      "method": "POST",
      "url": "${IDENTITY_WEBHOOK_URL}",
      "bodyFields": [
        "id",
        "First_Name",
        "Last_Name",
        "Date_of_Birth",
        "Mobile",
        "Phone",
        "Email",
        "Source_System",
        "Client_ID",
        "Global_Guest_ID",
        "Aroya_Loyalty_ID",
        "Guest_Identity",
        "Modified_Time"
      ],
      "headers": {
        "X-Event-Type": "GUEST_IDENTITY_REEVALUATION_REQUESTED",
        "X-Schema-Version": "1.0"
      }
    },
    {
      "name": "Identity_Evaluation_Requested_Direct",
      "module": "Contacts",
      "method": "POST",
      "url": "${IDENTITY_WEBHOOK_URL}",
      "bodyFields": [
        "id",
        "First_Name",
        "Last_Name",
        "Date_of_Birth",
        "Mobile",
        "Phone",
        "Email",
        "Source_System",
        "Client_ID",
        "Modified_Time"
      ],
      "headers": {
        "X-Event-Type": "GUEST_IDENTITY_EVALUATION_REQUESTED",
        "X-Source-System": "CRM_DIRECT",
        "X-Schema-Version": "1.0"
      }
    }
  ],
  "workflows": [
    {
      "name": "Identity fields changed",
      "module": "Contacts",
      "trigger": {
        "true": "edit",
        "specificFieldsChanged": [
          "First_Name",
          "Last_Name",
          "Date_of_Birth",
          "Mobile",
          "Phone",
          "Email"
        ]
      },
      "action": {
        "webhook": "Identity_Reevaluation_Requested"
      },
      "active": false
    },
    {
      "name": "Direct CRM guest created",
      "module": "Contacts",
      "trigger": {
        "true": "create"
      },
      "criteria": {
        "Source_System": {
          "notEquals": "SEAWARE"
        }
      },
      "action": {
        "webhook": "Identity_Evaluation_Requested_Direct"
      },
      "active": false
    }
  ],
  "webTab": {
    "name": "Identity Review",
    "url": "${WORKBENCH_URL}",
    "profiles": [
      "Identity Reviewer",
      "Identity Supervisor",
      "Identity Audit",
      "Administrator"
    ]
  }
}
