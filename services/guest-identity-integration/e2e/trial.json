{
 "about": "guest-identity-integration (role review): Review API and CRM webhook against made-up stand-ins of the Python decision service and zoho-sys-api (e2e/standin.py). Kafka is not set, as it is today: the webhook answers 503 and nothing is published. Reviewer contexts are signed with a trial-only secret.",
 "settings": {
  "role": "review",
  "webhookToken": "trial-webhook-token-not-real",
  "reviewAuth.signingSecret": "trial-review-secret-not-real",
  "reviewAuth.maxAgeSeconds": 315360000,
  "pythonServiceToken": "trial-python-token-not-real",
  "retries.firstBackoffSeconds": 0.01,
  "retries.maxBackoffSeconds": 0.02,
  "retries.maxAttempts": 2,
  "reviewAuth.serviceToken": "trial-bff-token-not-real"
 },
 "cases": [
  {
   "op": "GET /review-cases/{caseId}",
   "name": "open a case without a reviewer",
   "pathValues": {
    "caseId": "RC-1"
   },
   "expectStatus": 401,
   "expectNoCalls": [
    "python",
    "zohoSysApi"
   ]
  },
  {
   "op": "GET /review-cases/{caseId}",
   "name": "open a case: Python only, zero CRM calls",
