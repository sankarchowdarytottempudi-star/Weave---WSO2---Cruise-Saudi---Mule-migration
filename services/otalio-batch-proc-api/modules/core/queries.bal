// Copied by script from the old application's database queries (otalio-DB-impl.xml).
// The SQL text is unchanged apart from white space; the joined-in values are the parameters.

# Booking numbers changed in the window (old query 1).
#
# + skipBookingNum - Value joined into the text
# + fromText - Value joined into the text
# + toText - Value joined into the text
# + return - The SQL text
public isolated function changedBookingsQuery(string skipBookingNum, string fromText, string toText) returns string {
    return "select DISTINCT rp.booking_number FROM ReservationMS.OT_RSV_PERSON rp LEFT JOIN PmsMS.OT_PMS_PERSON_PROFILE pp ON rp.profile_id = pp.id LEFT JOIN CoreConfigMS.OT_CORECONF_CABIN_BUILD_B c ON rp.cabin_id = c.id LEFT JOIN PmsMS.OT_PMS_TRAVEL_DOCUMENT doc ON rp.profile_id = doc.person_profile_id LEFT JOIN PmsMS.OT_PMS_ADDRESS addr ON rp.profile_id = addr.profile_id WHERE 1 = 1 AND rp.booking_number not in " + skipBookingNum + " -- AND rp.cruise_product = 'AC01260101JEDYAN-3' AND rp.account_type = 'PAX' AND ( (rp.creation_dttm BETWEEN '" + fromText + "' AND '" + toText + "') OR (pp.creation_dttm BETWEEN '" + fromText + "' AND '" + toText + "') OR (doc.creation_dttm BETWEEN '" + fromText + "' AND '" + toText + "') OR (addr.creation_dttm BETWEEN '" + fromText + "' AND '" + toText + "') OR (rp.updated_dttm BETWEEN '" + fromText + "' AND '" + toText + "') OR (pp.updated_dttm BETWEEN '" + fromText + "' AND '" + toText + "') OR (doc.updated_dttm BETWEEN '" + fromText + "' AND '" + toText + "') OR (addr.updated_dttm BETWEEN '" + fromText + "' AND '" + toText + "') )";
}

# All guest rows of the given bookings (old query 2).
#
# + bookingNumbers - Value joined into the text
# + return - The SQL text
public isolated function reservationRowsQuery(string bookingNumbers) returns string {
    return "WITH comm_ranked AS ( SELECT comm.profile_id, comm.record_value, comm_type.communication_method, comm_lk.preferred_method, ROW_NUMBER() OVER ( PARTITION BY comm.profile_id, comm_type.communication_method ORDER BY CASE WHEN comm_lk.preferred_method = 1 THEN 1 ELSE 2 END, comm.id ) AS rn FROM PmsMS.OT_PMS_COMMUNICATION_INFO comm JOIN CoreConfigMS.OT_CORECONF_COMMUNICATION_TYPE_B comm_type ON comm.communication_type_id = comm_type.id JOIN PmsMS.OT_PMS_PERSON_COMM_LK comm_lk ON comm.id = comm_lk.comm_info_id ), comm_data AS ( SELECT profile_id, MAX(CASE WHEN rn = 1 THEN communication_method END) AS preferred_communication_method, MAX(CASE WHEN communication_method = 'E_MAIL' AND rn = 1 THEN record_value END) AS email, MAX(CASE WHEN communication_method = 'PHONE' AND rn = 1 THEN record_value END) AS phone_number, MAX(CASE WHEN communication_method = 'FAX' AND rn = 1 THEN record_value END) AS fax_number, MAX(CASE WHEN communication_method NOT IN ('PHONE', 'E_MAIL', 'FAX') AND rn = 1 THEN record_value END) AS other_contact FROM comm_ranked GROUP BY profile_id ), addr_ranked AS ( SELECT addr_lk.person_profile_id, addr_type_lookup.cd AS address_type_cd, addr_lk.preferred_method, ROW_NUMBER() OVER ( PARTITION BY addr_lk.person_profile_id ORDER BY CASE WHEN addr_lk.preferred_method = 1 THEN 1 ELSE 2 END, addr_lk.id ) AS rn FROM PmsMS.OT_PMS_PERSON_ADDRESS_LK addr_lk JOIN MetadataMS.OT_MD_LOOKUP_VALUE_B addr_type_lookup ON addr_type_lookup.id = addr_lk.address_type ), addr_data AS ( SELECT person_profile_id, address_type_cd, preferred_method FROM addr_ranked WHERE rn = 1 ), cabin_move_data AS ( SELECT cm.person_reservation_id, cm.old_cabin_id, cm.new_cabin_id, cm.reason, cm.last_check_out, old_cabin.cd AS old_cabin_code, old_cat_tl.description AS old_cabin_description, new_cabin.cd AS new_cabin_code, new_cat_tl.description AS new_cabin_description FROM ReservationMS.OT_RSV_CABIN_MOVE cm LEFT JOIN CoreConfigMS.OT_CORECONF_CABIN_BUILD_B old_cabin ON cm.old_cabin_id = old_cabin.id LEFT JOIN CoreConfigMS.OT_CORECONF_CABIN_CATEGORY_TL old_cat_tl ON old_cabin.assigned_cabin_category = old_cat_tl.entity_id LEFT JOIN CoreConfigMS.OT_CORECONF_CABIN_BUILD_B new_cabin ON cm.new_cabin_id = new_cabin.id LEFT JOIN CoreConfigMS.OT_CORECONF_CABIN_CATEGORY_TL new_cat_tl ON new_cabin.assigned_cabin_category = new_cat_tl.entity_id ), main_data AS ( SELECT DISTINCT rp.id, rp.booking_number, rp.travel_with, rp.external_id, rp.cruise_product, pp.external_id as clientId, rp.profile_id, rp.ship_id, rp.reservation_status_id, rp.marketing_consent, rp.account_type, rp.board_card_id, rp.onboard, rp.actual_embarkation_port_id, rp.scheduled_embarkation_date, rp.actual_embarkation_date, rp.actual_embarkation_time, rp.display_embarkation_date, rp.is_mismatch_embarkation_port, rp.actual_disembarkation_port_id, rp.scheduled_disembarkation_date, rp.actual_disembarkation_date, rp.actual_disembarkation_time, rp.display_disembarkation_date, rp.is_mismatch_disembarkation_port, port_info.cd AS emb_port_code, disemb_port_info.cd AS disemb_port_code, port_info.official_description AS defaultDescription, pp.first_name, pp.last_name, pp.date_of_birth as dateOfBirth, rp.cabin_id, c.cd AS Cabin_Code, c.cabin_type, c.assigned_deck, deck.cd AS deck_name, c.assigned_cabin_category, cat.cd AS cabin_category_name, ccat_tl.description, -- Cabin move details cmd.old_cabin_id, cmd.old_cabin_code, cmd.old_cabin_description, cmd.new_cabin_id, cmd.new_cabin_code, cmd.new_cabin_description, cmd.reason AS cabin_move_reason, cmd.last_check_out AS cabin_move_last_checkout, doc.document_type, doc.document_nr, doc.issue_nation AS issue_nation_id, nationality_lk.nationality AS issue_nation, nationality_lk.description as issue_country, doc.issue_place, doc.issue_date, doc.expiry_date, doc.birth_place, doc.valid_from, doc.visa_type, doc.issue_authority, pp.nationality_id AS p_nationality_id, country_lk.nationality, country_lk.description AS country, doc.nationality_id AS d_nationality_id, doc.is_primary_document, addr.street_1, addr.street_2, addr.street_3, addr.city, addr.country_id, addr.zip_code, addr.state, addr.profile_type, comm_data.email, comm_data.phone_number, comm_data.fax_number, comm_data.other_contact, comm_data.preferred_communication_method, addr_data.address_type_cd, addr_data.preferred_method AS addr_preferred_method, rp.creation_dttm AS rp_crdtm, rp.updated_dttm AS rp_updtm, pp.creation_dttm AS pp_crdtm, doc.creation_dttm AS doc_crdtm, addr.creation_dttm AS addr_crdtm, country_lk.creation_dttm AS country_crdtm, pp.updated_dttm AS pp_updtm, doc.updated_dttm AS doc_updtm, addr.updated_dttm AS addr_updtm, country_lk.updated_dttm AS country_updtm FROM ReservationMS.OT_RSV_PERSON rp LEFT JOIN PmsMS.OT_PMS_PERSON_PROFILE pp ON rp.profile_id = pp.id LEFT JOIN CoreConfigMS.OT_CORECONF_CABIN_BUILD_B c ON rp.cabin_id = c.id LEFT JOIN CoreConfigMS.OT_CORECONF_DECK_B deck ON deck.id = c.assigned_deck LEFT JOIN CoreConfigMS.OT_CORECONF_CABIN_CATEGORY_B cat ON cat.id = c.assigned_cabin_category LEFT JOIN CoreConfigMS.OT_CORECONF_CABIN_CATEGORY_TL ccat_tl ON c.assigned_cabin_category = ccat_tl.entity_id LEFT JOIN PmsMS.OT_PMS_TRAVEL_DOCUMENT doc ON rp.profile_id = doc.person_profile_id LEFT JOIN PmsMS.OT_PMS_ADDRESS addr ON rp.profile_id = addr.profile_id LEFT JOIN CoreConfigMS.OT_CORECONF_COUNTRY_TL country_lk ON pp.nationality_id = country_lk.entity_id LEFT JOIN CoreConfigMS.OT_CORECONF_COUNTRY_TL nationality_lk ON doc.issue_nation = nationality_lk.entity_id LEFT JOIN CoreConfigMS.OT_CORECONF_PORT_B port_info ON rp.actual_embarkation_port_id = port_info.id LEFT JOIN CoreConfigMS.OT_CORECONF_PORT_B disemb_port_info ON rp.actual_disembarkation_port_id = disemb_port_info.id LEFT JOIN comm_data ON rp.profile_id = comm_data.profile_id LEFT JOIN addr_data ON rp.profile_id = addr_data.person_profile_id LEFT JOIN cabin_move_data cmd ON cmd.person_reservation_id = rp.id WHERE 1 = 1 AND rp.booking_number in (" + bookingNumbers + ") ) SELECT * FROM main_data order by booking_number, COALESCE(rp_updtm, rp_crdtm), rp_crdtm; ";
}

# Revenue per payer (old query 3).
#
# + payerIds - Value joined into the text
# + return - The SQL text
public isolated function revenueQuery(string payerIds) returns string {
    return "WITH payer_summary_cte AS ( SELECT r.payer_id, -- Total invoice amount per payer SUM(r.gross_total) AS total_invoice_by_payer, -- Addons total SUM(r.package_amount) AS addons_total, -- Additional charges (tax + VAT) SUM(r.tax_total + r.vat_total) AS additional_charges, -- Total amount due SUM(r.package_amount) AS total_amount_due, -- Total excluding VAT (needs confirmation) SUM(r.gross_total - COALESCE(r.vat_total, 0)) AS total_excluding_vat, -- Total VAT SUM(r.vat_total) AS total_vat, -- Total debit amount per payer SUM(CASE WHEN r.transaction_type = 'DEBIT' THEN r.net_total ELSE 0 END) AS debit_total, -- Total credit amount per payer SUM(CASE WHEN r.transaction_type = 'CREDIT' THEN r.net_total ELSE 0 END) AS credit_total, -- Net balance (debit - credit) SUM(CASE WHEN r.transaction_type = 'DEBIT' THEN r.net_total ELSE 0 END) - SUM(CASE WHEN r.transaction_type = 'CREDIT' THEN r.net_total ELSE 0 END) AS current_balance FROM ReportingMS.OT_REVENUE_OVERVIEW_V r LEFT JOIN ReservationMS.OT_RSV_PERSON p ON r.payer_id = p.id WHERE r.payer_id in (" + payerIds + ") GROUP BY r.payer_id ) select distinct v.payer_id, v.main_department_description, -- Finance record / invoice ID v.check_number AS finance_name, -- Invoice or reference number v.check_number AS invoice_number, -- Due date (not in view) -- Currency and exchange rate (non-aggregated) v.currency_code AS currency, v.exchange_rate AS exchange_rate, -- Balance due (not in view) NULL AS balance_due, -- Payment type if available v.payment_type AS due_type, -- Shorex total (needs confirmation) v.sub_department_amount_in_foreign AS shorex_total, -- Guest Name CONCAT(v.first_name, ' ', v.last_name) AS guest_name, NULL AS due_date, -- Total invoice amount per payer (from aggregated CTE) c.total_invoice_by_payer AS total_invoice, -- Addons total (aggregated) c.addons_total, -- Additional charges (tax + VAT) c.additional_charges, -- Total amount due (needs confirmation) c.total_amount_due, -- Total amount paid (not in view) NULL AS total_amount_paid, -- Total excluding VAT (aggregated) c.total_excluding_vat, -- Total VAT (aggregated) c.total_vat, -- Debit, Credit, and Current Balance (from CTE) c.debit_total, c.credit_total, c.current_balance FROM ReportingMS.OT_REVENUE_OVERVIEW_V v JOIN payer_summary_cte c ON v.payer_id = c.payer_id";
}

# Postings per buyer (old query 4).
#
# + buyerIds - Value joined into the text
# + return - The SQL text
public isolated function transactionsQuery(string buyerIds) returns string {
    return "SELECT rp.profile_id, p.id, -- pd.folio_number AS folioNumber, p.check_id AS checkId, p.check_number, p.transaction_type AS transactionType, p.business_date AS businessDate, p.creation_dttm AS postingCreatedDate, p.updated_dttm as postingUpdatedDate, -- (pd.sub_department_amount -- + COALESCE(pd.package_amount, 0) -- + COALESCE(pd.discount_amount, 0)) AS totalAmount, p.currency_id AS currencyId, currency.cd AS currencyCode, p.voyage_id AS voyageId, v.cd AS voyageCode, p.buyer AS buyerAccountId, p.buyer_account_type AS buyerAccountType, ship.legalname AS shipName, p.main_department_id AS mainDepartmentId, dep.description AS mainDepartmentDescription, p.comments AS comments, p.reversal_id AS reversalId, -- pd.discount_amount AS discount, p.is_non_refundable_credit AS nonRefundCredit, p.settlement_id as settlementId, ops.approve_amount as settlementAmount, ops.settlement_response_dttm as settlementDateTime, ops.settlement_status as settlementStatus FROM FinanceMS.OT_FIN_POSTING p left JOIN ReservationMS.OT_RSV_PERSON rp ON p.buyer = rp.id left JOIN PosMS.OT_CHECKS c ON p.check_id = c.id left JOIN CoreConfigMS.OT_CORECONF_CURRENCY_B currency ON p.currency_id = currency.id left JOIN CoreConfigMS.OT_CORECONF_ITINERARY_VOYAGE_B v ON p.voyage_id = v.id left JOIN FinanceMS.OT_FIN_MAIN_DEPARTMENT_TL dep ON p.main_department_id = dep.entity_id left JOIN MetadataMS.OT_MD_SHIP_B ship ON ship.id = p.ship_id left join PaymentGatewayMS.OT_PG_SETTLEMENTS ops on ops.id = p.settlement_id WHERE p.buyer IN (" + buyerIds + ")";
}

# Posting items per posting (old query 5).
#
# + postingIds - Value joined into the text
# + return - The SQL text
public isolated function postingItemsQuery(string postingIds) returns string {
    return " SELECT -- rp.profile_id, pd.id, pd.posting_id, pd.folio_number, pd.article_id AS articleId, artdesc.description AS articleDescription, -- art.cd AS articleCode, pd.description AS postingDescription, pd.creation_dttm as createdDateTime, pd.updated_dttm as updatedDateTime, pd.code AS postingCode, pd.count AS postingCount, pd.sub_department_id AS subDepartmentId, d.description AS subDepartmentDescription, pd.sub_department_amount AS subDepartmentAmount, pd.payer_id AS payerId, pd.transaction_id AS transactionId, pd.posting_type AS postingType, pd.posting_update_type AS updateType, pd.is_deposit AS isDeposit, pd.discount_amount AS discountAmount, pd.vat_total AS vatTotal, pd.vat_total_percent AS vatTotalPercent, pd.tax_total AS addonTaxTotal, pd.tax_total_percent AS addonTaxTotalPercent, pd.pos_payer AS posPayer, pd.package_amount AS packageAmount, pd.onboard_currency AS onboardCurrency, pd.new_payer_id as newPayerId, pd.source_posting_id_link as sourcePostingIdLink, pd.posting_before_id as postingBeforeId, pd.is_posting_closed as isPostingClosed, pd.checks_package_id AS checksPackageId, cp.check_total AS checkTotal, ptl.description AS packageDescription, pd.pkg_paymnet_sub_dep_entity_id AS pkgPaymentSubDepEntityId, sd2.description AS pkgPaymentSubDeptDesc, pd.payer_account_type AS payerAccountType FROM FinanceMS.OT_FIN_POSTING_DETAIL pd JOIN FinanceMS.OT_FIN_SUB_DEPARTMENT_TL d ON d.entity_id = pd.sub_department_id LEFT JOIN FinanceMS.OT_CQRS_ARTICLE_TL artdesc ON pd.article_id = artdesc.entity_id LEFT JOIN PosMS.OT_CHECKS_PACKAGE cp ON cp.id = pd.checks_package_id LEFT JOIN FinanceMS.OT_FIN_SUB_DEPARTMENT_TL sd2 ON sd2.entity_id = pd.pkg_paymnet_sub_dep_entity_id LEFT JOIN PosMS.OT_PACKAGE_TL ptl ON ptl.entity_id = cp.package_entity_id WHERE pd.posting_id in (" + postingIds + ")";
}
