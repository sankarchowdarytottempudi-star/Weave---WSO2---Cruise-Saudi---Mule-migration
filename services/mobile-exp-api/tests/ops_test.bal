import ballerina/http;
import ballerina/test;

// Generated by the migration factory: the ported operations against a local stand-in.
// Every backend address in tests/Config.toml points at localhost:19590.

listener http:Listener standInListener = new (19590);

service / on standInListener {
    isolated resource function 'default [string... path](http:Request request) returns json => {};
}

final http:Client underTest = check new ("http://localhost:19369", {timeout: 20});

isolated function call(string method, string path, map<string> headers, json? body, string contentType)
        returns http:Response|error {
    http:Request req = new;
    foreach [string, string] [k, v] in headers.entries() {
        req.setHeader(k, v);
    }
    if body is string && contentType != "application/json" {
        req.setTextPayload(body, contentType);
    } else if body !is () {
        req.setJsonPayload(body);
    }
    return underTest->execute(method, path, req);
}

@test:Config {}
function GET__activity_planner_v1_activities_fitsContract() returns error? {
    http:Response res = check call("GET", "/mobile-exp-api/v1/activity-planner/v1/activities", {"Authorization": "Bearer <accessToken>"}, (), "application/json");
    test:assertFalse(res.statusCode == 404 || res.statusCode == 405 || res.statusCode == 415 || res.statusCode == 501,
        "GET /activity-planner/v1/activities: a request that fits the contract was refused (" + res.statusCode.toString() + ")");
}

@test:Config {}
function GET__activity_planner_v1_activities_missingHeader() returns error? {
    http:Response res = check call("GET", "/mobile-exp-api/v1/activity-planner/v1/activities", {}, (), "application/json");
    test:assertTrue(res.statusCode >= 400, "GET /activity-planner/v1/activities: missing header Authorization was accepted");
}

