    http:Response res = check call("POST", "/mobile-exp-api/v1/ism/v1/service-item-requests", {"Authorization": "Bearer <accessToken>"}, {"affectedPersons": ["539b4197496e11f1bf322becbb9b2337"], "complaint": false, "contactedById": "539b4197496e11f1bf322becbb9b2337", "contactedHowId": "feb5360a56ec11e996740a580af4005e", "createdBy": "system", "creationDTTM": "2026-07-19T11:16:56.243Z", "documentIds": [], "firstExperience": "2026-07-19T11:16:56.243Z", "originIsMaintenance": false, "personMaintenanceRequestIds": [], "physicalCabinId": "3c4d99dbfe8811eeb555d2bc2be678e3", "physicalLocationId": (), "portId": (), "safety": false, "security": false, "serviceItemCodeRequestId": "034abd26b38411f08eaa155e0746cbc1", "serviceRequestType": "PERSONAL", "shipId": "8dcc009689ab11e8be3dfa2819c4da71", "status": "PENDING", "tags": [], "updatedBy": (), "updatedDTTM": "2026-07-19T11:16:56.243Z", "voyageId": "e62ec620207a11f18d582306eaee054b", "watchList": false}, "application/json");
    test:assertFalse(res.statusCode == 404 || res.statusCode == 405 || res.statusCode == 415 || res.statusCode == 501,
        "POST /ism/v1/service-item-requests: a request that fits the contract was refused (" + res.statusCode.toString() + ")");
}

@test:Config {}
function POST__ism_v1_service_item_requests_missingHeader() returns error? {
    http:Response res = check call("POST", "/mobile-exp-api/v1/ism/v1/service-item-requests", {}, {"affectedPersons": ["539b4197496e11f1bf322becbb9b2337"], "complaint": false, "contactedById": "539b4197496e11f1bf322becbb9b2337", "contactedHowId": "feb5360a56ec11e996740a580af4005e", "createdBy": "system", "creationDTTM": "2026-07-19T11:16:56.243Z", "documentIds": [], "firstExperience": "2026-07-19T11:16:56.243Z", "originIsMaintenance": false, "personMaintenanceRequestIds": [], "physicalCabinId": "3c4d99dbfe8811eeb555d2bc2be678e3", "physicalLocationId": (), "portId": (), "safety": false, "security": false, "serviceItemCodeRequestId": "034abd26b38411f08eaa155e0746cbc1", "serviceRequestType": "PERSONAL", "shipId": "8dcc009689ab11e8be3dfa2819c4da71", "status": "PENDING", "tags": [], "updatedBy": (), "updatedDTTM": "2026-07-19T11:16:56.243Z", "voyageId": "e62ec620207a11f18d582306eaee054b", "watchList": false}, "application/json");
    test:assertTrue(res.statusCode >= 400, "POST /ism/v1/service-item-requests: missing header Authorization was accepted");
}

@test:Config {}
function POST__ism_v1_service_item_requests_wrongContentType() returns error? {
    http:Response res = check call("POST", "/mobile-exp-api/v1/ism/v1/service-item-requests", {"Authorization": "Bearer <accessToken>"}, "x", "text/plain");
    test:assertTrue(res.statusCode >= 400, "POST /ism/v1/service-item-requests: a text body was accepted");
}

