import ballerina/test;

// Generated by the migration factory: the DataWeave runtime against DataWeave's own answers.

function dwCase(string name, isolated function (Ro) returns json f, json payload, map<json> vars, json expected)
        returns error? {
    Ro r = {payload: payload.cloneReadOnly(), vars: vars.cloneReadOnly(), attributes: {}, err: (), message: (),
        correlationId: "c-1", appName: "app", app: (), mule: (), server: ()};
    json got = check trap f(r);
    boolean same = got == expected || (got is int|decimal|float && expected is int|decimal|float
        && <decimal>got == <decimal>expected);
    test:assertTrue(same, name + ": got " + got.toJsonString() + ", DataWeave answers " + expected.toJsonString());
}

@test:Config {}
function dataWeaveRuntime() returns error? {
    check dwCase("sel", dwt_sel, {"a": {"b": 3}}, {}, 3);
    check dwCase("missing", dwt_missing, {}, {}, "none");
    check dwCase("obj", dwt_obj, {"id": "7", "n": "ab"}, {}, {"id": "7", "name": "AB", "tag": "x7"});
    check dwCase("mapidx", dwt_mapidx, [{"v": 1}, {"v": 2}], {}, [{"i": 0, "v": 1}, {"i": 1, "v": 2}]);
    check dwCase("dollar", dwt_dollar, [{"v": 1}, {"v": 2}], {}, [2, 4]);
    check dwCase("filter", dwt_filter, [{"ok": true, "id": 1}, {"ok": false, "id": 2}], {}, [1]);
    check dwCase("ifelse", dwt_ifelse, [1, 2], {}, "many");
    check dwCase("isEmpty", dwt_isEmpty, {"x": ""}, {}, {"a": true, "b": true, "c": false});
    check dwCase("vars", dwt_vars, {}, {"key": "K", "n": 41}, {"key": "K", "n": 42});
    check dwCase("fun", dwt_fun, {"n": 4}, {}, 8);
    check dwCase("interp", dwt_interp, {"name": "Ann", "age": 30}, {}, "Hello Ann, you are 30");
    check dwCase("joinsplit", dwt_joinsplit, {"s": "a,b,c"}, {}, "a-b-c");
    check dwCase("pluck", dwt_pluck, {"a": "1", "b": "2"}, {}, ["a=1", "b=2"]);
    check dwCase("groupBy", dwt_groupBy, [{"t": "x", "v": 1}, {"t": "y", "v": 2}, {"t": "x", "v": 3}], {}, {"x": [{"t": "x", "v": 1}, {"t": "x", "v": 3}], "y": [{"t": "y", "v": 2}]});
    check dwCase("orderBy", dwt_orderBy, [{"v": 3}, {"v": 1}, {"v": 2}], {}, [1, 2, 3]);
    check dwCase("distinct", dwt_distinct, [1, 2, 1, 3, 2], {}, [1, 2, 3]);
    check dwCase("reduce", dwt_reduce, [1, 2, 3, 4], {}, 10);
    check dwCase("flatten", dwt_flatten, [[1, 2], [3], []], {}, [1, 2, 3]);
    check dwCase("match", dwt_match, {"t": "b"}, {}, 2);
    check dwCase("do", dwt_do, {"n": 3}, {}, 12);
    check dwCase("asNumber", dwt_asNumber, {"s": "41"}, {}, 42);
    check dwCase("numfmt", dwt_numfmt, {"n": 3.14159}, {}, "3.14");
    check dwCase("datefmt", dwt_datefmt, {"d": "2026-11-16T07:05:00Z"}, {}, "16/11/2026");
    check dwCase("dateparse", dwt_dateparse, {"d": "05-03-2026"}, {}, "2026-03-05");
    check dwCase("dyn", dwt_dyn, {"k": "name", "v": 1}, {}, {"name": 1});
    check dwCase("concatobj", dwt_concatobj, {"a": 1}, {}, {"a": 1, "c": 3});
    check dwCase("nullsafe", dwt_nullsafe, {"a": ()}, {}, ());
    check dwCase("contains", dwt_contains, {"s": "hello"}, {}, true);
    check dwCase("regex", dwt_regex, {"s": "ab12cd34"}, {}, "ab#cd#");
    check dwCase("scan", dwt_scan, {"s": "a1 b2"}, {}, [["a1", "a", "1"], ["b2", "b", "2"]]);
    check dwCase("write", dwt_write, (), {}, "{\n  \"a\": 1\n}");
    check dwCase("read", dwt_read, "{\"x\": 5}", {}, 5);
    check dwCase("keys", dwt_keys, {"a": 1, "b": 2}, {}, ["a", "b"]);
    check dwCase("multi", dwt_multi, {"items": [{"id": 1}, {"id": 2}]}, {}, [1, 2]);
    check dwCase("idx", dwt_idx, [1, 2, 3], {}, 3);
    check dwCase("range", dwt_range, [1, 2, 3], {}, [1, 2]);
    check dwCase("mapObject", dwt_mapObject, {"a": 1}, {}, {"A": 1});
    check dwCase("filterObject", dwt_filterObject, {"a": 1, "b": ()}, {}, {"a": 1});
    check dwCase("eqnum", dwt_eqnum, {"a": 1.0}, {}, true);
    check dwCase("andor", dwt_andor, {"a": 2, "b": "x"}, {}, true);
    check dwCase("notop", dwt_notop, [1], {}, true);
    check dwCase("attrs", dwt_attrs, (), {}, "none");
    check dwCase("isType", dwt_isType, [1], {}, true);
    check dwCase("datePlus", dwt_datePlus, {"d": "2026-12-31"}, {}, "2027-01-01");
    check dwCase("sizeOfObj", dwt_sizeOfObj, {"a": 1, "b": 2}, {}, 2);
    check dwCase("leftPad", dwt_leftPad, {"s": "42"}, {}, "00042");
    check dwCase("trim", dwt_trim, {"s": "  x  "}, {}, "x");
    check dwCase("bothInterp", dwt_bothInterp, {"id": 9}, {}, "id-9");
    check dwCase("condField", dwt_condField, {"b": 2}, {}, {"a": 1, "b": 2});
    check dwCase("condItem", dwt_condItem, {"ok": true}, {}, [1, 2]);
    check dwCase("mod", dwt_mod, {"n": 7}, {}, true);
    check dwCase("lambdaNoParens", dwt_lambdaNoParens, [{"id": 1, "v": "x"}, {"id": 2, "v": "y"}], {}, "y");
    check dwCase("kvObj", dwt_kvObj, [{"a": 1}], {}, [{"a": 1, "tag": "x"}]);
    check dwCase("kvParen", dwt_kvParen, [{"a": 1}], {}, [{"a": 1, "n": 2}]);
    check dwCase("funVar", dwt_funVar, {"n": 5}, {}, 15);
}

isolated function dwt_sel(Ro c) returns json {
    return dwSel(dwSel(c.payload, "a"), "b");
}

isolated function dwt_missing(Ro c) returns json {
    return dwDefault(dwSel(dwSel(c.payload, "x"), "y"), <json>"none");
}

isolated function dwt_obj(Ro c) returns json {
    return <json>{"id": dwSel(c.payload, "id"), "name": dwUpper(dwSel(c.payload, "n")), "tag": dwConcat(<json>"x", dwSel(c.payload, "id"))};
}

isolated function dwt_mapidx(Ro c) returns json {
    return dwMap(c.payload, isolated function (readonly & json v_item_1, readonly & json v_index_2) returns json => <json>{"i": v_index_2, "v": dwSel(v_item_1, "v")});
}

isolated function dwt_dollar(Ro c) returns json {
    return dwMap(c.payload, isolated function (readonly & json v_item_1, readonly & json v_index_2) returns json => dwTimes(dwSel(v_item_1, "v"), <json>2));
}

isolated function dwt_filter(Ro c) returns json {
    return dwMap(dwFilter(c.payload, isolated function (readonly & json v_item_1, readonly & json v_index_2) returns json => dwSel(v_item_1, "ok")), isolated function (readonly & json v_item_4, readonly & json v_index_5) returns json => dwSel(v_item_4, "id"));
}

isolated function dwt_ifelse(Ro c) returns json {
    return (dwTruthy(dwGt(dwSizeOf(c.payload), <json>1)) ? <json>"many" : <json>"one");
}

isolated function dwt_isEmpty(Ro c) returns json {
    return <json>{"a": dwIsEmpty(dwSel(c.payload, "x")), "b": dwIsEmpty(<json>[]), "c": dwIsEmpty(<json>"q")};
}

isolated function dwt_vars(Ro c) returns json {
    final readonly & json v_k = (dwSel(c.vars, "key")).cloneReadOnly();
    return <json>{"key": v_k, "n": dwPlus(dwSel(c.vars, "n"), <json>1)};
}

isolated function dwt_fun(Ro c) returns json {
    final isolated function (readonly & json) returns json fn_twice = isolated function (readonly & json v_x_1) returns json => dwTimes(v_x_1, <json>2);
    return fn_twice((dwSel(c.payload, "n")).cloneReadOnly());
}

isolated function dwt_interp(Ro c) returns json {
    return <json>("Hello " + dwText(dwSel(c.payload, "name")) + ", you are " + dwText(dwSel(c.payload, "age")));
}

isolated function dwt_joinsplit(Ro c) returns json {
    return dwJoinBy(dwSplitBy(dwSel(c.payload, "s"), <json>","), <json>"-");
}

isolated function dwt_pluck(Ro c) returns json {
    return dwPluck(c.payload, isolated function (readonly & json v_v_1, readonly & json v_k_2, readonly & json v_unused2_3) returns json => dwConcat(dwConcat(v_k_2, <json>"="), v_v_1));
}

isolated function dwt_groupBy(Ro c) returns json {
    return dwGroupBy(c.payload, isolated function (readonly & json v_item_1, readonly & json v_index_2) returns json => dwSel(v_item_1, "t"));
}

isolated function dwt_orderBy(Ro c) returns json {
    return dwMap(dwOrderBy(c.payload, isolated function (readonly & json v_item_1, readonly & json v_index_2) returns json => dwSel(v_item_1, "v")), isolated function (readonly & json v_item_4, readonly & json v_index_5) returns json => dwSel(v_item_4, "v"));
}

isolated function dwt_distinct(Ro c) returns json {
    return dwDistinctBy(c.payload, isolated function (readonly & json v_item_1, readonly & json v_index_2) returns json => v_item_1);
}

isolated function dwt_reduce(Ro c) returns json {
    return dwReduce(c.payload, isolated function (readonly & json v_item_1, readonly & json v_acc_2) returns json => dwPlus(v_acc_2, v_item_1), <json>0, true);
}

isolated function dwt_flatten(Ro c) returns json {
    return dwFlatten(c.payload);
}

isolated function dwt_match(Ro c) returns json {
    return dwLet(dwSel(c.payload, "t"), isolated function (readonly & json v_m_1) returns json => (dwTruthy(dwEq(v_m_1, <json>"a")) ? <json>1 : (dwTruthy(dwEq(v_m_1, <json>"b")) ? <json>2 : <json>0)));
}

isolated function dwt_do(Ro c) returns json {
    return dwLet(dwSel(c.payload, "n"), isolated function (readonly & json v_x_1) returns json => dwLet(dwPlus(v_x_1, <json>1), isolated function (readonly & json v_y_2) returns json => dwTimes(v_x_1, v_y_2)));
}

isolated function dwt_asNumber(Ro c) returns json {
    return dwPlus(dwAsNumber(dwSel(c.payload, "s"), ()), <json>1);
}

isolated function dwt_numfmt(Ro c) returns json {
    return dwAsString(dwSel(c.payload, "n"), <json>{"format": <json>"0.00"});
}

isolated function dwt_datefmt(Ro c) returns json {
    return dwAsString(dwSel(c.payload, "d"), <json>{"format": <json>"dd/MM/yyyy"});
}

isolated function dwt_dateparse(Ro c) returns json {
    return dwAsDate(dwSel(c.payload, "d"), <json>{"format": <json>"dd-MM-yyyy"});
}

isolated function dwt_dyn(Ro c) returns json {
    return dwObject([dwEntry(dwText(dwSel(c.payload, "k")), dwSel(c.payload, "v"))]);
}

isolated function dwt_concatobj(Ro c) returns json {
    return dwConcat(c.payload, <json>{"c": <json>3});
}

isolated function dwt_nullsafe(Ro c) returns json {
    return dwSel(dwSel(dwSel(c.payload, "a"), "b"), "c");
}

isolated function dwt_contains(Ro c) returns json {
    return dwContains(dwSel(c.payload, "s"), <json>"ell");
}

isolated function dwt_regex(Ro c) returns json {
    return dwReplace(dwSel(c.payload, "s"), <json>"\u{1}re:[0-9]+", <json>"#");
}

isolated function dwt_scan(Ro c) returns json {
    return dwScan(dwSel(c.payload, "s"), <json>"\u{1}re:(\\w)(\\d)");
}

isolated function dwt_write(Ro c) returns json {
    return dwWrite(<json>{"a": <json>1}, <json>"application/json");
}

isolated function dwt_read(Ro c) returns json {
    return dwSel(dwRead(c.payload, <json>"application/json"), "x");
}

isolated function dwt_keys(Ro c) returns json {
    return dwKeysOf(c.payload);
}

isolated function dwt_multi(Ro c) returns json {
    return dwSel(dwSel(c.payload, "items"), "id");
}

isolated function dwt_idx(Ro c) returns json {
    return dwIdx(c.payload, <json>-1);
}

isolated function dwt_range(Ro c) returns json {
    return dwRange(c.payload, <json>0, <json>1);
}

isolated function dwt_mapObject(Ro c) returns json {
    return dwMapObject(c.payload, isolated function (readonly & json v_v_1, readonly & json v_k_2, readonly & json v_unused2_3) returns json => dwObject([dwEntry(dwText(dwUpper(v_k_2)), v_v_1)]));
}

isolated function dwt_filterObject(Ro c) returns json {
    return dwFilterObject(c.payload, isolated function (readonly & json v_v_1, readonly & json v_unused1_2, readonly & json v_unused2_3) returns json => dwNe(v_v_1, ()));
}

isolated function dwt_eqnum(Ro c) returns json {
    return dwEq(dwSel(c.payload, "a"), <json>1);
}

isolated function dwt_andor(Ro c) returns json {
    return (dwTruthy((dwTruthy(dwGt(dwSel(c.payload, "a"), <json>1)) && dwTruthy(dwEq(dwSel(c.payload, "b"), <json>"x")))) || dwTruthy(false));
}

isolated function dwt_notop(Ro c) returns json {
    return (!dwTruthy(dwIsEmpty(c.payload)));
}

isolated function dwt_attrs(Ro c) returns json {
    return dwDefault(dwSel(dwSel(c.attributes, "queryParams"), "q"), <json>"none");
}

isolated function dwt_isType(Ro c) returns json {
    return dwIs(c.payload, "Array");
}

isolated function dwt_datePlus(Ro c) returns json {
    return dwPlus(dwSel(c.payload, "d"), <json>"P1D");
}

isolated function dwt_sizeOfObj(Ro c) returns json {
    return dwSizeOf(c.payload);
}

isolated function dwt_leftPad(Ro c) returns json {
    return dwLeftPad(dwSel(c.payload, "s"), <json>5, <json>"0");
}

isolated function dwt_trim(Ro c) returns json {
    return dwTrim(dwSel(c.payload, "s"));
}

isolated function dwt_bothInterp(Ro c) returns json {
    return dwConcat(<json>"id-", dwAsString(dwSel(c.payload, "id"), ()));
}

isolated function dwt_condField(Ro c) returns json {
    return dwObject([dwEntry("a", <json>1), (dwTruthy(dwNe(dwSel(c.payload, "b"), ())) ? dwEntry("b", dwSel(c.payload, "b")) : ()), (dwTruthy(false) ? dwEntry("c", <json>3) : ())]);
}

isolated function dwt_condItem(Ro c) returns json {
    return dwCompact([<json>1, (dwTruthy(dwSel(c.payload, "ok")) ? <json>2 : <json>SKIP_MARK), (dwTruthy((!dwTruthy(dwSel(c.payload, "ok")))) ? <json>3 : <json>SKIP_MARK)]);
}

isolated function dwt_mod(Ro c) returns json {
    return dwEq(dwMod(dwSel(c.payload, "n"), <json>2), <json>1);
}

isolated function dwt_lambdaNoParens(Ro c) returns json {
    return dwSel(dwIdx(dwFilter(c.payload, isolated function (readonly & json v_item_1, readonly & json v_unused1_2) returns json => dwEq(dwSel(v_item_1, "id"), <json>2)), <json>0), "v");
}

isolated function dwt_kvObj(Ro c) returns json {
    return dwMap(c.payload, isolated function (readonly & json v_item_1, readonly & json v_index_2) returns json => dwConcat(v_item_1, <json>{"tag": <json>"x"}));
}

isolated function dwt_kvParen(Ro c) returns json {
    return dwMap(c.payload, isolated function (readonly & json v_item_1, readonly & json v_index_2) returns json => dwConcat(v_item_1, <json>{"n": dwPlus(dwSel(v_item_1, "a"), <json>1)}));
}

isolated function dwt_funVar(Ro c) returns json {
    final readonly & json v_base = (<json>10).cloneReadOnly();
    final isolated function (readonly & json) returns json fn_add = isolated function (readonly & json v_x_1) returns json => dwPlus(v_x_1, v_base);
    return fn_add((dwSel(c.payload, "n")).cloneReadOnly());
}

