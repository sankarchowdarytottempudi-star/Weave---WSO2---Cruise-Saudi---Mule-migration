// DataWeave runtime: the meaning of DataWeave's operators and core functions on json values.
// Generated by the migration factory next to every service whose logic was ported from Mule.
// Do not edit; regenerate. Dates are ISO-8601 text; a regex is text marked with RE_MARK.
import ballerina/lang.regexp;
import ballerina/time;
import ballerina/uuid;

# The old application's properties (p('name') and ${name}), filled from its property files.
configurable map<string> props = {};

const string RE_MARK = "\u{1}re:";
const string ENTRY_MARK = "\u{1}entry";
const string SPREAD_MARK = "\u{1}spread";
const string SKIP_MARK = "\u{1}skip";

# What one DataWeave expression sees: the Mule event, read-only.
public type Ro readonly & record {|
    json payload;
    map<json> vars;
    map<json> attributes;
    json err;
    json message;
    string correlationId;
    string appName;
    json app;
    json mule;
    json server;
|};

public type DwFn1 isolated function (readonly & json a) returns json;
public type DwFn2 isolated function (readonly & json a, readonly & json b) returns json;
public type DwFn3 isolated function (readonly & json a, readonly & json b, readonly & json c) returns json;

isolated function dwFail(string what) returns never {
    panic error("MULE:EXPRESSION", message = what);
}

// ------------------------------------------------------------------ basics

isolated function dwTruthy(json v) returns boolean {
    if v is boolean {
        return v;
    }
    if v is string {
        return v.toLowerAscii() == "true";
    }
    return false;
}

isolated function isNum(json v) returns boolean => v is int|decimal|float;

isolated function dec(json v) returns decimal {
    if v is int {
        return <decimal>v;
    }
    if v is decimal {
        return v;
    }
    if v is float {
        return <decimal>v;
    }
    if v is string {
        decimal|error d = decimal:fromString(v.trim());
        if d is decimal {
            return d;
        }
    }
    dwFail("Cannot coerce " + dwTypeName(v) + " to Number");
}

isolated function num(decimal d) returns json {
    if d == d.floor() && d.abs() < 1000000000000000000d {
        return <int>d;
    }
    return d;
}

isolated function dwTypeName(json v) returns string {
    if v is () {
        return "Null";
    }
    if v is boolean {
        return "Boolean";
    }
    if v is int|decimal|float {
        return "Number";
    }
    if v is string {
        return "String";
    }
    if v is json[] {
        return "Array";
    }
    return "Object";
}

isolated function dwText(json v) returns string {
    if v is () {
        return "";
    }
    if v is string {
        return v;
    }
    if v is boolean {
        return v ? "true" : "false";
    }
    if v is int {
        return v.toString();
    }
    if v is decimal {
        return v.toString();
    }
    if v is float {
        return v.toString();
    }
    return v.toJsonString();
}

isolated function dwLet(json v, DwFn1 f) returns json => f(v.cloneReadOnly());

isolated function dwIdentity2(json v, json w) returns json => v;

// ------------------------------------------------------------------ selectors

isolated function dwSel(json o, string k) returns json {
    if o is map<json> {
        return o[k];
    }
    if o is json[] {
        json[] out = [];
        foreach json x in o {
            if x is map<json> && x.hasKey(k) {
                out.push(x[k]);
            }
        }
        return out;
    }
    return ();
}

isolated function dwIdx(json o, json i) returns json {
    if i is string {
        return dwSel(o, i);
    }
    int n = <int>dec(i);
    if o is json[] {
        int at = n < 0 ? o.length() + n : n;
        return at >= 0 && at < o.length() ? o[at] : ();
    }
    if o is string {
        int at = n < 0 ? o.length() + n : n;
        return at >= 0 && at < o.length() ? o.substring(at, at + 1) : ();
    }
    if o is map<json> {
        json[] vals = o.toArray();
        int at = n < 0 ? vals.length() + n : n;
        return at >= 0 && at < vals.length() ? vals[at] : ();
    }
    return ();
}

isolated function dwRange(json o, json a, json b) returns json {
    int fromI = <int>dec(a);
    int toI = <int>dec(b);
    if o is json[] {
        int s = fromI < 0 ? o.length() + fromI : fromI;
        int e = toI < 0 ? o.length() + toI : toI;
        if s < 0 || e >= o.length() || s > e {
            return ();
        }
        return o.slice(s, e + 1);
    }
    if o is string {
        int s = fromI < 0 ? o.length() + fromI : fromI;
        int e = toI < 0 ? o.length() + toI : toI;
        if s < 0 || e >= o.length() || s > e {
            return ();
        }
        return o.substring(s, e + 1);
    }
    return ();
}

isolated function dwIs(json v, string t) returns json {
    match t {
        "String"|"Date"|"DateTime"|"LocalDateTime"|"Time"|"LocalTime"|"Key" => {
            return v is string;
        }
        "Number" => {
            return isNum(v);
        }
        "Boolean" => {
            return v is boolean;
        }
        "Array" => {
            return v is json[];
        }
        "Object" => {
            return v is map<json>;
        }
        "Null" => {
            return v is ();
        }
    }
    return true;
}

// ------------------------------------------------------------------ objects

isolated function dwEntry(string k, json v) returns json => [ENTRY_MARK, k, v];

isolated function dwObject(json[] parts) returns json {
    map<json> out = {};
    foreach json p in parts {
        if p is json[] && p.length() >= 2 && p[0] == ENTRY_MARK {
            out[dwText(p[1])] = p[2];
        } else if p is json[] && p[0] == SPREAD_MARK {
            json o = p[1];
            if o is map<json> {
                foreach [string, json] [k, v] in o.entries() {
                    out[k] = v;
                }
            } else if o is json[] {
                foreach json x in o {
                    if x is map<json> {
                        foreach [string, json] [k, v] in x.entries() {
                            out[k] = v;
                        }
                    }
                }
            }
        }
    }
    return out;
}

isolated function dwCompact(json[] xs) returns json => from json x in xs where x != SKIP_MARK select x;

isolated function dwKeysOf(json o) returns json => o is map<json> ? <json>o.keys() : ();

// ------------------------------------------------------------------ operators

isolated function dwEq(json a, json b) returns json {
    if isNum(a) && isNum(b) {
        return dec(a) == dec(b);
    }
    return a == b;
}

isolated function dwNe(json a, json b) returns json => !<boolean>dwEq(a, b);

isolated function cmp(json a, json b) returns int? {
    if isNum(a) && isNum(b) {
        decimal x = dec(a);
        decimal y = dec(b);
        return x < y ? -1 : x > y ? 1 : 0;
    }
    if a is string && b is string {
        return a < b ? -1 : a > b ? 1 : 0;
    }
    if a is boolean && b is boolean {
        return a == b ? 0 : (a ? 1 : -1);
    }
    return ();
}

isolated function dwGt(json a, json b) returns json {
    int? c = cmp(a, b);
    return c is int && c > 0;
}

isolated function dwConcat(json a, json b) returns json {
    if a is json[] || b is json[] {
        json[] out = [];
        if a is json[] {
            out.push(...a);
        } else if a !is () {
            out.push(a);
        }
        if b is json[] {
            out.push(...b);
        } else if b !is () {
            out.push(b);
        }
        return out;
    }
    if a is map<json> || b is map<json> {
        map<json> out = {};
        if a is map<json> {
            foreach [string, json] [k, v] in a.entries() {
                out[k] = v;
            }
        }
        if b is map<json> {
            foreach [string, json] [k, v] in b.entries() {
                out[k] = v;
            }
        }
        return out;
    }
    return dwText(a) + dwText(b);
}

isolated function dwPlus(json a, json b) returns json {
    if a is string && b is string && b.startsWith("P") {
        return dateShift(a, b, 1);
    }
    return num(dec(a) + dec(b));
}

isolated function dwMinus(json a, json b) returns json {
    if a is string && b is string && b.startsWith("P") {
        return dateShift(a, b, -1);
    }
    if a is string && b is string {
        return dwDaysBetween(b, a);
    }
    return num(dec(a) - dec(b));
}

isolated function dwTimes(json a, json b) returns json => num(dec(a) * dec(b));

isolated function dwMod(json a, json b) returns json => num(dec(a) % dec(b));

isolated function dwDefault(json a, json b) returns json => a is () ? b : a;

isolated function dwIsEmpty(json v) returns json {
    if v is () {
        return true;
    }
    if v is string {
        return v.length() == 0;
    }
    if v is json[] {
        return v.length() == 0;
    }
    if v is map<json> {
        return v.length() == 0;
    }
    return false;
}

isolated function dwSizeOf(json v) returns json {
    if v is string {
        return v.length();
    }
    if v is json[] {
        return v.length();
    }
    if v is map<json> {
        return v.length();
    }
    return 0;
}

// ------------------------------------------------------------------ strings

isolated function dwUpper(json v) returns json => v is () ? () : dwText(v).toUpperAscii();

isolated function dwTrim(json v) returns json => v is () ? () : dwText(v).trim();

isolated function isRe(json v) returns boolean => v is string && v.startsWith(RE_MARK);

isolated function reOf(json v) returns regexp:RegExp {
    string pattern = dwText(v);
    if pattern.startsWith(RE_MARK) {
        pattern = pattern.substring(RE_MARK.length());
    }
    regexp:RegExp|error r = regexp:fromString(pattern);
    if r is error {
        dwFail("Unsupported regular expression: " + pattern);
    }
    return r;
}

isolated function dwContains(json a, json b) returns json {
    if a is () {
        return false;
    }
    if a is json[] {
        foreach json x in a {
            if <boolean>dwEq(x, b) {
                return true;
            }
        }
        return false;
    }
    if isRe(b) {
        return reOf(b).find(dwText(a)) is regexp:Span;
    }
    return dwText(a).includes(dwText(b));
}

isolated function dwStartsWith(json a, json b) returns json => a !is () && dwText(a).startsWith(dwText(b));

isolated function dwLeftPad(json a, json n, json ch = " ") returns json {
    string s = dwText(a);
    while s.length() < <int>dec(n) {
        s = dwText(ch) + s;
    }
    return s;
}

isolated function dwJoinBy(json a, json sep) returns json {
    if a is () {
        return ();
    }
    if a !is json[] {
        return dwText(a);
    }
    string[] parts = from json x in a select dwText(x);
    return string:'join(dwText(sep), ...parts);
}

isolated function dwSplitBy(json a, json sep) returns json {
    if a is () {
        return ();
    }
    string s = dwText(a);
    if isRe(sep) {
        return <json>reOf(sep).split(s);
    }
    string d = dwText(sep);
    json[] out = [];
    if d == "" {
        foreach string:Char ch in s {
            out.push(ch);
        }
        return out;
    }
    int st0 = 0;
    while true {
        int? i = s.indexOf(d, st0);
        if i is () {
            out.push(s.substring(st0));
            break;
        }
        out.push(s.substring(st0, i));
        st0 = i + d.length();
    }
    return out;
}

isolated function dwReplace(json a, json pattern, json replacement) returns json {
    if a is () {
        return ();
    }
    if isRe(pattern) {
        return reOf(pattern).replaceAll(dwText(a), dwText(replacement));
    }
    string s = dwText(a);
    string p = dwText(pattern);
    if p == "" {
        return s;
    }
    string out = "";
    int st0 = 0;
    while true {
        int? i = s.indexOf(p, st0);
        if i is () {
            out += s.substring(st0);
            break;
        }
        out += s.substring(st0, i) + dwText(replacement);
        st0 = i + p.length();
    }
    return out;
}

isolated function groupsOf(regexp:Groups g) returns json[] {
    json[] out = [];
    foreach regexp:Span? s in g {
        out.push(s is regexp:Span ? s.substring() : ());
    }
    return out;
}

isolated function dwScan(json a, json pattern) returns json {
    if a is () {
        return ();
    }
    json[] out = [];
    foreach regexp:Groups g in reOf(pattern).findAllGroups(dwText(a)) {
        out.push(groupsOf(g));
    }
    return out;
}

// ------------------------------------------------------------------ arrays

isolated function items(json a) returns json[] {
    readonly & json r = a.cloneReadOnly();
    if r is json[] {
        return r;
    }
    return [];
}

isolated function dwMap(json a, DwFn2 f) returns json {
    if a is () {
        return ();
    }
    json[] out = [];
    json[] xs = items(a);
    foreach int i in 0 ..< xs.length() {
        out.push(f(xs[i].cloneReadOnly(), i));
    }
    return out;
}

isolated function dwFilter(json a, DwFn2 f) returns json {
    if a is () {
        return ();
    }
    if a is string {
        string out = "";
        foreach int i in 0 ..< a.length() {
            if dwTruthy(f(a.substring(i, i + 1), i)) {
                out += a.substring(i, i + 1);
            }
        }
        return out;
    }
    json[] out = [];
    json[] xs = items(a);
    foreach int i in 0 ..< xs.length() {
        if dwTruthy(f(xs[i].cloneReadOnly(), i)) {
            out.push(xs[i]);
        }
    }
    return out;
}

isolated function dwFlatten(json a) returns json {
    if a is () {
        return ();
    }
    json[] out = [];
    foreach json x in items(a) {
        if x is json[] {
            out.push(...x);
        } else {
            out.push(x);
        }
    }
    return out;
}

isolated function dwPluck(json o, DwFn3 f) returns json {
    if o is () {
        return ();
    }
    json[] out = [];
    readonly & json r = o.cloneReadOnly();
    if r is map<json> {
        int i = 0;
        foreach [string, json] [k, v] in r.entries() {
            out.push(f(v.cloneReadOnly(), k, i));
            i += 1;
        }
    }
    return out;
}

isolated function dwMapObject(json o, DwFn3 f) returns json {
    if o is () {
        return ();
    }
    map<json> out = {};
    readonly & json r = o.cloneReadOnly();
    if r is map<json> {
        int i = 0;
        foreach [string, json] [k, v] in r.entries() {
            json part = f(v.cloneReadOnly(), k, i);
            if part is map<json> {
                foreach [string, json] [pk, pv] in part.entries() {
                    out[pk] = pv;
                }
            }
            i += 1;
        }
    }
    return out;
}

isolated function dwFilterObject(json o, DwFn3 f) returns json {
    if o is () {
        return ();
    }
    map<json> out = {};
    readonly & json r = o.cloneReadOnly();
    if r is map<json> {
        int i = 0;
        foreach [string, json] [k, v] in r.entries() {
            if dwTruthy(f(v.cloneReadOnly(), k, i)) {
                out[k] = v;
            }
            i += 1;
        }
    }
    return out;
}

isolated function dwGroupBy(json a, DwFn2 f) returns json {
    if a is () {
        return ();
    }
    map<json> out = {};
    json[] xs = items(a);
    foreach int i in 0 ..< xs.length() {
        string k = dwText(f(xs[i].cloneReadOnly(), i));
        json cur = out[k];
        json[] list = cur is json[] ? cur : [];
        list.push(xs[i]);
        out[k] = list;
    }
    return out;
}

isolated function dwOrderBy(json a, DwFn2 f) returns json {
    if a is () {
        return ();
    }
    json[] xs = items(a);
    [json, json][] keyed = [];
    foreach int i in 0 ..< xs.length() {
        keyed.push([f(xs[i].cloneReadOnly(), i), xs[i]]);
    }
    // stable insertion sort (DataWeave orderBy is stable)
    foreach int i in 1 ..< keyed.length() {
        [json, json] cur = keyed[i];
        int j = i - 1;
        while j >= 0 {
            int? c = cmp(keyed[j][0], cur[0]);
            if c is int && c > 0 {
                keyed[j + 1] = keyed[j];
                j -= 1;
            } else {
                break;
            }
        }
        keyed[j + 1] = cur;
    }
    return from [json, json] k in keyed select k[1];
}

isolated function dwDistinctBy(json a, DwFn2 f) returns json {
    if a is () {
        return ();
    }
    json[] out = [];
    json[] seen = [];
    json[] xs = items(a);
    foreach int i in 0 ..< xs.length() {
        json k = f(xs[i].cloneReadOnly(), i);
        boolean dup = false;
        foreach json s in seen {
            if <boolean>dwEq(s, k) {
                dup = true;
                break;
            }
        }
        if !dup {
            seen.push(k);
            out.push(xs[i]);
        }
    }
    return out;
}

isolated function dwReduce(json a, DwFn2 f, json init, boolean hasInit) returns json {
    json[] xs = items(a);
    if xs.length() == 0 {
        return hasInit ? init : ();
    }
    json acc = hasInit ? init : xs[0];
    int st0 = hasInit ? 0 : 1;
    foreach int i in st0 ..< xs.length() {
        acc = f(xs[i].cloneReadOnly(), acc.cloneReadOnly());
    }
    return acc;
}

// ------------------------------------------------------------------ coercions and formats

isolated function dwAsString(json v, json fmt = ()) returns json {
    string? pattern = fmtOf(fmt);
    if pattern is string && isNum(v) {
        return numberFormat(dec(v), pattern);
    }
    if pattern is string && v is string {
        return dateFormat(v, pattern);
    }
    return v is () ? () : dwText(v);
}

isolated function fmtOf(json fmt) returns string? {
    if fmt is map<json> {
        json f = fmt["format"];
        return f is string ? f : ();
    }
    return ();
}

isolated function dwAsNumber(json v, json fmt = ()) returns json {
    if v is () {
        return ();
    }
    if isNum(v) {
        return v;
    }
    string s = dwText(v).trim();
    string? pattern = fmtOf(fmt);
    if pattern is string {
        s = regexp:replaceAll(re `,`, s, "");
    }
    int|error i = int:fromString(s);
    if i is int {
        return i;
    }
    decimal|error d = decimal:fromString(s);
    if d is decimal {
        return d;
    }
    dwFail("Cannot coerce String (" + s + ") to Number");
}

isolated function dwAsBoolean(json v, json fmt = ()) returns json {
    if v is boolean || v is () {
        return v;
    }
    string s = dwText(v).toLowerAscii();
    if s == "true" || s == "false" {
        return s == "true";
    }
    dwFail("Cannot coerce " + dwTypeName(v) + " to Boolean");
}

isolated function numberFormat(decimal d, string pattern) returns string {
    string p = pattern;
    int? dot = p.indexOf(".");
    int minFrac = 0;
    int maxFrac = 0;
    if dot is int {
        string frac = p.substring(dot + 1);
        foreach string:Char ch in frac {
            if ch == "0" {
                minFrac += 1;
                maxFrac += 1;
            } else if ch == "#" {
                maxFrac += 1;
            }
        }
    }
    string intPart = dot is int ? p.substring(0, dot) : p;
    boolean grouping = intPart.includes(",");
    int minInt = 0;
    foreach string:Char ch in intPart {
        if ch == "0" {
            minInt += 1;
        }
    }
    decimal r = d.round(maxFrac);
    boolean neg = r < 0d;
    decimal a = r.abs();
    string whole = (<int>a.floor()).toString();
    while whole.length() < minInt {
        whole = "0" + whole;
    }
    if whole == "0" && minInt == 0 && maxFrac > 0 && a < 1d {
        whole = "";
    }
    if grouping {
        string g = "";
        int cnt = 0;
        int i = whole.length() - 1;
        while i >= 0 {
            g = whole.substring(i, i + 1) + g;
            cnt += 1;
            if cnt % 3 == 0 && i > 0 {
                g = "," + g;
            }
            i -= 1;
        }
        whole = g;
    }
    string fracText = "";
    if maxFrac > 0 {
        decimal f = a - a.floor();
        string digits = "";
        decimal x = f;
        foreach int k in 0 ..< maxFrac {
            x = x * 10d;
            int dg = <int>x.floor();
            digits += dg.toString();
            x = x - <decimal>dg;
        }
        int keep = digits.length();
        while keep > minFrac && digits.substring(keep - 1, keep) == "0" {
            keep -= 1;
        }
        fracText = digits.substring(0, keep);
    }
    string out = fracText.length() > 0 ? whole + "." + fracText : whole;
    return (neg ? "-" : "") + (out == "" ? "0" : out);
}

// ------------------------------------------------------------------ dates (ISO-8601 text)

type Dt record {|
    int y;
    int mo;
    int d;
    int h = 0;
    int mi = 0;
    int s = 0;
    int ms = 0;
    string zone = "";
    boolean hasTime = false;
|};

isolated function digitsOf(string s) returns int? {
    if s.length() == 0 {
        return ();
    }
    foreach string:Char ch in s {
        if ch < "0" || ch > "9" {
            return ();
        }
    }
    int|error n = int:fromString(s);
    return n is int ? n : ();
}

isolated function parseIso(string v0) returns Dt? {
    string v = v0.trim();
    int? br = v.indexOf("[");
    if br is int {
        v = v.substring(0, br);
    }
    if v.length() < 10 || v.substring(4, 5) != "-" || v.substring(7, 8) != "-" {
        return ();
    }
    int? y = digitsOf(v.substring(0, 4));
    int? mo = digitsOf(v.substring(5, 7));
    int? d = digitsOf(v.substring(8, 10));
    if y is () || mo is () || d is () {
        return ();
    }
    Dt out = {y, mo, d};
    string rest = v.substring(10);
    if rest.length() == 0 {
        return out;
    }
    string first = rest.substring(0, 1);
    if first != "T" && first != " " {
        return ();
    }
    rest = rest.substring(1);
    // zone
    if rest.endsWith("Z") {
        out.zone = "Z";
        rest = rest.substring(0, rest.length() - 1);
    } else {
        int? plus = rest.lastIndexOf("+");
        int? minus = rest.lastIndexOf("-");
        int? zi = plus is int ? plus : minus;
        if zi is int && zi >= 5 {
            out.zone = rest.substring(zi);
            rest = rest.substring(0, zi);
        }
    }
    string[] hms = re `:`.split(rest);
    if hms.length() < 2 {
        return ();
    }
    int? h = digitsOf(hms[0]);
    int? mi = digitsOf(hms[1]);
    if h is () || mi is () {
        return ();
    }
    out.h = h;
    out.mi = mi;
    out.hasTime = true;
    if hms.length() > 2 {
        string sec = hms[2];
        int? dot = sec.indexOf(".");
        if dot is int {
            string frac = (sec.substring(dot + 1) + "000").substring(0, 3);
            int? ms = digitsOf(frac);
            out.ms = ms ?: 0;
            sec = sec.substring(0, dot);
        }
        int? s = digitsOf(sec);
        if s is () {
            return ();
        }
        out.s = s;
    }
    return out;
}

isolated function pad(int v, int w) returns string {
    string s = v.toString();
    while s.length() < w {
        s = "0" + s;
    }
    return s;
}

final readonly & string[] MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August",
    "September", "October", "November", "December"];
final readonly & string[] DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

isolated function dayOfWeek(int y, int m, int d) returns int {
    // 0 = Monday
    int[] t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
    int yy = m < 3 ? y - 1 : y;
    int w = (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7;   // 0 = Sunday
    return (w + 6) % 7;
}

isolated function zoneText(string z, string style) returns string {
    string zz = z == "" ? "Z" : z;
    if zz == "Z" {
        return style == "Z" ? "+0000" : "Z";
    }
    string sign = zz.substring(0, 1);
    string digits = regexp:replaceAll(re `:`, zz.substring(1), "");
    if style == "XXX" {
        return sign + digits.substring(0, 2) + ":" + digits.substring(2, 4);
    }
    if style == "X" {
        return sign + digits.substring(0, 2);
    }
    return sign + digits;
}

isolated function dateFormat(string v, string pattern) returns string {
    Dt? p = parseIso(v);
    if p is () {
        return v;
    }
    string out = "";
    int i = 0;
    while i < pattern.length() {
        string ch = pattern.substring(i, i + 1);
        if ch == "'" {
            int? j = pattern.indexOf("'", i + 1);
            if j is () {
                out += pattern.substring(i + 1);
                break;
            }
            out += j == i + 1 ? "'" : pattern.substring(i + 1, j);
            i = j + 1;
            continue;
        }
        int k = i;
        while k < pattern.length() && pattern.substring(k, k + 1) == ch {
            k += 1;
        }
        int w = k - i;
        match ch {
            "y"|"u" => {
                out += w == 2 ? pad(p.y % 100, 2) : pad(p.y, w);
            }
            "M" => {
                out += w >= 4 ? MONTHS[p.mo - 1] : w == 3 ? MONTHS[p.mo - 1].substring(0, 3) : pad(p.mo, w);
            }
            "d" => {
                out += pad(p.d, w);
            }
            "H" => {
                out += pad(p.h, w);
            }
            "h" => {
                int h12 = p.h % 12 == 0 ? 12 : p.h % 12;
                out += pad(h12, w);
            }
            "m" => {
                out += pad(p.mi, w);
            }
            "s" => {
                out += pad(p.s, w);
            }
            "S" => {
                out += pad(p.ms, 3).substring(0, int:min(w, 3)) + (w > 3 ? pad(0, w - 3) : "");
            }
            "a" => {
                out += p.h < 12 ? "AM" : "PM";
            }
            "E" => {
                string day = DAYS[dayOfWeek(p.y, p.mo, p.d)];
                out += w >= 4 ? day : day.substring(0, 3);
            }
            "X"|"x" => {
                out += zoneText(p.zone, w >= 3 ? "XXX" : w == 1 ? "X" : "XX");
            }
            "Z" => {
                out += zoneText(p.zone, "Z");
            }
            "z" => {
                out += p.zone == "" || p.zone == "Z" ? "UTC" : p.zone;
            }
            _ => {
                out += pattern.substring(i, k);
            }
        }
        i = k;
    }
    return out;
}

isolated function isoOf(Dt p, boolean withTime, boolean withZone) returns string {
    string s = pad(p.y, 4) + "-" + pad(p.mo, 2) + "-" + pad(p.d, 2);
    if withTime {
        s += "T" + pad(p.h, 2) + ":" + pad(p.mi, 2) + ":" + pad(p.s, 2) + (p.ms > 0 ? "." + pad(p.ms, 3) : "");
        if withZone {
            s += p.zone == "" ? "Z" : p.zone;
        }
    }
    return s;
}

isolated function parseWith(string v, string pattern) returns Dt? {
    // turn a Java date pattern into a regular expression with one group per field
    string rx = "";
    string[] fields = [];
    int i = 0;
    while i < pattern.length() {
        string ch = pattern.substring(i, i + 1);
        if ch == "'" {
            int? j = pattern.indexOf("'", i + 1);
            int end = j is int ? j : pattern.length();
            rx += escapeRe(pattern.substring(i + 1, end));
            i = end + 1;
            continue;
        }
        int k = i;
        while k < pattern.length() && pattern.substring(k, k + 1) == ch {
            k += 1;
        }
        int w = k - i;
        if "yMdHhmsSa".includes(ch) || ch == "X" || ch == "Z" {
            fields.push(ch + w.toString());
            rx += ch == "a" ? "(AM|PM|am|pm)" : ch == "X" || ch == "Z" ? "(Z|[+\\-]\\d{2}:?\\d{2})" :
                (ch == "M" && w >= 3) ? "([A-Za-z]+)" : "(\\d{1," + int:max(w, ch == "y" ? 4 : 2).toString() + "})";
        } else {
            rx += escapeRe(pattern.substring(i, k));
        }
        i = k;
    }
    regexp:RegExp|error r = regexp:fromString(rx);
    if r is error {
        return ();
    }
    regexp:Groups? g = r.fullMatchGroups(v.trim());
    if g is () {
        return ();
    }
    Dt out = {y: 1970, mo: 1, d: 1};
    boolean pm = false;
    foreach int fi in 0 ..< fields.length() {
        regexp:Span? s = g[fi + 1];
        if s is () {
            continue;
        }
        string text = s.substring();
        string f = fields[fi].substring(0, 1);
        int w = checkpanic int:fromString(fields[fi].substring(1));
        if f == "a" {
            pm = text.toUpperAscii() == "PM";
            continue;
        }
        if f == "X" || f == "Z" {
            out.zone = text;
            continue;
        }
        if f == "M" && w >= 3 {
            foreach int mi in 0 ..< 12 {
                if MONTHS[mi].toLowerAscii().startsWith(text.toLowerAscii()) {
                    out.mo = mi + 1;
                }
            }
            continue;
        }
        int n = checkpanic int:fromString(text);
        match f {
            "y" => {
                out.y = w == 2 ? 2000 + n : n;
            }
            "M" => {
                out.mo = n;
            }
            "d" => {
                out.d = n;
            }
            "H"|"h" => {
                out.h = n;
                out.hasTime = true;
            }
            "m" => {
                out.mi = n;
            }
            "s" => {
                out.s = n;
            }
            "S" => {
                out.ms = n;
            }
        }
    }
    if pm && out.h < 12 {
        out.h += 12;
    }
    return out;
}

isolated function escapeRe(string s) returns string {
    string out = "";
    foreach string:Char ch in s {
        out += "\\^$.|?*+()[]{}".includes(ch) ? "\\" + ch : ch;
    }
    return out;
}

isolated function asDateLike(json v, json fmt, boolean time, boolean zone) returns json {
    if v is () {
        return ();
    }
    string s = dwText(v);
    string? pattern = fmtOf(fmt);
    Dt? p = pattern is string ? parseWith(s, pattern) : parseIso(s);
    if p is () {
        dwFail("Cannot coerce String (" + s + ") to " + (time ? "DateTime" : "Date"));
    }
    return isoOf(p, time, zone);
}

isolated function dwAsDate(json v, json fmt = ()) returns json => asDateLike(v, fmt, false, false);

isolated function dwNow() returns json {
    string s = time:utcToString(time:utcNow());
    // milliseconds, as DataWeave prints them
    regexp:Groups? g = re `(.*T\d{2}:\d{2}:\d{2})(?:\.(\d+))?Z`.fullMatchGroups(s);
    if g is regexp:Groups {
        regexp:Span? a = g[1];
        regexp:Span? b = g[2];
        string frac = b is regexp:Span ? (b.substring() + "000").substring(0, 3) : "000";
        return (a is regexp:Span ? a.substring() : s) + "." + frac + "Z";
    }
    return s;
}

isolated function epochDays(Dt p) returns int {
    int y = p.mo <= 2 ? p.y - 1 : p.y;
    int era = (y >= 0 ? y : y - 399) / 400;
    int yoe = y - era * 400;
    int mp = (p.mo + 9) % 12;
    int doy = (153 * mp + 2) / 5 + p.d - 1;
    int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

isolated function fromEpochDays(int z0, Dt base) returns Dt {
    int z = z0 + 719468;
    int era = (z >= 0 ? z : z - 146096) / 146097;
    int doe = z - era * 146097;
    int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    int y = yoe + era * 400;
    int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    int mp = (5 * doy + 2) / 153;
    int d = doy - (153 * mp + 2) / 5 + 1;
    int m = mp < 10 ? mp + 3 : mp - 9;
    return {y: m <= 2 ? y + 1 : y, mo: m, d, h: base.h, mi: base.mi, s: base.s, ms: base.ms, zone: base.zone, hasTime: base.hasTime};
}

isolated function dateShift(string v, string period, int sign) returns json {
    Dt? p = parseIso(v);
    if p is () {
        dwFail("Not a date: " + v);
    }
    int[] n = [0, 0, 0, 0, 0, 0, 0];      // Y M W D H M S
    boolean inTime = false;
    string acc = "";
    if !period.startsWith("P") {
        dwFail("Unsupported period: " + period);
    }
    foreach string:Char ch in period.substring(1) {
        if ch >= "0" && ch <= "9" {
            acc += ch;
            continue;
        }
        if ch == "T" {
            inTime = true;
            continue;
        }
        int val = acc == "" ? 0 : checkpanic int:fromString(acc);
        acc = "";
        int slot = inTime ? (ch == "H" ? 4 : ch == "M" ? 5 : ch == "S" ? 6 : -1)
            : (ch == "Y" ? 0 : ch == "M" ? 1 : ch == "W" ? 2 : ch == "D" ? 3 : -1);
        if slot < 0 {
            dwFail("Unsupported period: " + period);
        }
        n[slot] = val;
    }
    Dt q = p.clone();
    int months = q.mo - 1 + sign * (n[0] * 12 + n[1]);
    q.y = q.y + (months >= 0 ? months / 12 : -((11 - months) / 12));
    q.mo = ((months % 12) + 12) % 12 + 1;
    int days = epochDays(q) + sign * (n[2] * 7 + n[3]);
    int secs = q.h * 3600 + q.mi * 60 + q.s + sign * (n[4] * 3600 + n[5] * 60 + n[6]);
    days += secs >= 0 ? secs / 86400 : -((86399 - secs) / 86400);
    secs = ((secs % 86400) + 86400) % 86400;
    Dt r = fromEpochDays(days, q);
    r.h = secs / 3600;
    r.mi = (secs % 3600) / 60;
    r.s = secs % 60;
    return isoOf(r, p.hasTime, p.zone != "" || p.hasTime);
}

isolated function dwDaysBetween(json a, json b) returns json {
    Dt? x = parseIso(dwText(a));
    Dt? y = parseIso(dwText(b));
    if x is () || y is () {
        return ();
    }
    return epochDays(y) - epochDays(x);
}

// ------------------------------------------------------------------ io and misc

isolated function dwWrite(json v, json mime = "application/json", json opts = ()) returns json {
    string m = dwText(mime);
    if m.includes("json") {
        boolean indent = !(opts is map<json> && opts["indent"] == false);
        return indent ? pretty(v, "") : v.toJsonString();
    }
    return dwText(v);
}

isolated function pretty(json v, string ind) returns string {
    if v is map<json> {
        if v.length() == 0 {
            return "{}";
        }
        string[] parts = [];
        foreach [string, json] [k, x] in v.entries() {
            parts.push(ind + "  " + k.toJsonString() + ": " + pretty(x, ind + "  "));
        }
        return "{\n" + string:'join(",\n", ...parts) + "\n" + ind + "}";
    }
    if v is json[] {
        if v.length() == 0 {
            return "[]";
        }
        string[] parts = from json x in v select ind + "  " + pretty(x, ind + "  ");
        return "[\n" + string:'join(",\n", ...parts) + "\n" + ind + "]";
    }
    return v.toJsonString();
}

isolated function dwRead(json v, json mime = "application/json", json opts = ()) returns json {
    if v is () {
        return ();
    }
    if v !is string {
        return v;
    }
    string m = dwText(mime);
    if m.includes("json") {
        json|error parsed = v.fromJsonString();
        if parsed is error {
            dwFail("Unexpected content when reading JSON");
        }
        return parsed;
    }
    return v;
}

isolated function dwUuid() returns json => uuid:createType4AsString();

isolated function dwProp(json key) returns json {
    string k = dwText(key);
    string? v = props[k] ?: props["\"" + k + "\""];   // keys with dots are quoted in the settings file and keep their quotes
    return v;
}

# `${name}` and p('name') outside DataWeave: the property's text, or the name itself when unset.
isolated function propText(string text) returns string {
    string out = text;
    while true {
        int? s = out.indexOf("${");
        if s is () {
            break;
        }
        int? e = out.indexOf("}", s);
        if e is () {
            break;
        }
        string name = out.substring(s + 2, e);
        string? v = props[name] ?: props["\"" + name + "\""];
        out = out.substring(0, s) + (v ?: "") + out.substring(e + 1);
    }
    return out;
}

