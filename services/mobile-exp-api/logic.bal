import ballerina/http;
import ballerina/lang.regexp;
import ballerina/lang.runtime;
import ballerina/log;
import ballerina/url;

import aroya/integration_commons as commons;

// Runtime of the ported Mule flows. Generated by the migration factory; regenerate, do not edit.

const string APP_NAME = "mobile-exp-api";

# The Mule event as the ported flows see it.
type Event record {|
    readonly & json payload = ();
    readonly & map<json> vars = {};
    readonly & map<json> attributes = {};
    readonly & json err = ();
    string mime = "application/java";
    string correlationId = "";
|};

# A Mule error: its type (NAMESPACE:IDENTIFIER), description and the message it carried.
type MuleError distinct error<record {| string errorType; json payload; json attributes; string failingFlow; |}>;

isolated function muleError(string errorType, string description, json payload = (), json attributes = ()) returns MuleError
    => error MuleError(description, errorType = errorType, payload = payload.cloneReadOnly(), attributes = attributes.cloneReadOnly(),
        failingFlow = "");

# The flow an error started in (Mule's error.failingComponent); the innermost flow wins.
isolated function withFlow(error err, string flow) returns MuleError {
    MuleError me = asMule(err);
    if me.detail().failingFlow != "" {
        return me;
    }
    return error MuleError(me.message(), errorType = me.detail().errorType, payload = me.detail().payload,
        attributes = me.detail().attributes, failingFlow = flow);
}

isolated function notPorted(int statusCode, string note) returns MuleError
    => muleError("MULE:NOT_PORTED", "Not migrated yet: " + note);

isolated function asMule(error err) returns MuleError {
    if err is MuleError {
        return err;
    }
    string text = err.message();
    var detail = err.detail();
    var m = detail["message"];
    if m is string {
        text = m;
    }
    return muleError(err.message() == "MULE:EXPRESSION" ? "MULE:EXPRESSION" : "MULE:UNKNOWN", text);
}

isolated function errView(MuleError me) returns readonly & json {
    string t = me.detail().errorType;
    int? c = t.indexOf(":");
    string ns = c is int ? t.substring(0, c) : "MULE";
    string id = c is int ? t.substring(c + 1) : t;
    json v = {
        description: me.message(),
        detailedDescription: me.message(),
        errorType: {namespace: ns, identifier: id, asString: ns + ":" + id},
        errorMessage: {payload: me.detail().payload, attributes: me.detail().attributes},
        cause: {message: me.message()},
        failingComponent: me.detail().failingFlow == "" ? () : me.detail().failingFlow + "/processors/0"
    };
    return v.cloneReadOnly();
}

isolated function typeMatches(MuleError me, string[] types) returns boolean {
    string t = me.detail().errorType;
    foreach string want0 in types {
        string want = want0.includes(":") ? want0 : "MULE:" + want0;
        if want == "MULE:ANY" || want == t {
            return true;
        }
        if want.endsWith(":*") && t.startsWith(want.substring(0, want.length() - 1)) {
            return true;
        }
        if want.startsWith("*:") && t.endsWith(want.substring(1)) {
            return true;
        }
        if want == "MULE:CONNECTIVITY" && (t.endsWith(":CONNECTIVITY") || t.endsWith(":TIMEOUT")) {
            return true;
        }
        if (want == "HTTP:CLIENT_SECURITY" || want == "MULE:CLIENT_SECURITY" || want == "MULE:SECURITY")
                && (t == "HTTP:UNAUTHORIZED" || t == "HTTP:FORBIDDEN") {
            return true;
        }
        if want == "MULE:RETRY_EXHAUSTED" && t.endsWith(":RETRY_EXHAUSTED") {
            return true;
        }
    }
    return false;
}

isolated function ro(Event e) returns Ro => {
    payload: e.payload,
    vars: e.vars,
    attributes: e.attributes,
    err: e.err,
    message: {payload: e.payload, attributes: e.attributes},
    correlationId: e.correlationId,
    appName: APP_NAME,
    app: {name: APP_NAME},
    mule: {version: "4"},
    server: ()
};

isolated function dwEval(isolated function (Ro) returns json f, Event e) returns (readonly & json)|error {
    json|error v = trap f(ro(e));
    if v is error {
        return asMule(v);
    }
    return v.cloneReadOnly();
}

isolated function withVar(readonly & map<json> vars, string k, json v) returns readonly & map<json> {
    map<json> m = {};
    foreach [string, json] [k2, v2] in vars.entries() {
        m[k2] = v2;
    }
    m[k] = v;
    return m.cloneReadOnly();
}

isolated function withoutVar(readonly & map<json> vars, string k) returns readonly & map<json> {
    map<json> m = {};
    foreach [string, json] [k2, v2] in vars.entries() {
        if k2 != k {
            m[k2] = v2;
        }
    }
    return m.cloneReadOnly();
}

isolated function mergeVars(readonly & map<json> a, readonly & map<json> b) returns readonly & map<json> {
    map<json> m = {};
    foreach [string, json] [k, v] in a.entries() {
        m[k] = v;
    }
    foreach [string, json] [k, v] in b.entries() {
        m[k] = v;
    }
    return m.cloneReadOnly();
}

isolated function dwItemsOf(json v) returns json[] {
    if v is json[] {
        return v.clone();
    }
    if v is () {
        return [];
    }
    return [v];
}

isolated function copyEvent(readonly & Event e) returns Event => {payload: e.payload, vars: e.vars,
    attributes: e.attributes, err: e.err, mime: e.mime, correlationId: e.correlationId};

isolated function runAsync(isolated function (Event) returns error? f, readonly & Event e) {
    error? r = trap f(copyEvent(e));
    if r is error {
        log:printError("async scope failed", correlationId = e.correlationId, reason = r.message());
    }
}

isolated function untilSuccessful(isolated function (Event) returns error? f, Event e, string retries, string millis) returns error? {
    int|error mx = int:fromString(retries.trim());
    int|error ms = int:fromString(millis.trim());
    int maxRetries = mx is int ? mx : 5;
    decimal pause = ms is int ? <decimal>ms / 1000d : 60d;
    int attempt = 0;
    while true {
        Event copy = copyEvent(e.cloneReadOnly());
        error? r = f(copy);
        if r is () {
            e.payload = copy.payload;
            e.vars = copy.vars;
            e.attributes = copy.attributes;
            e.mime = copy.mime;
            return;
        }
        if attempt >= maxRetries {
            return muleError("MULE:RETRY_EXHAUSTED", "'until-successful' retries exhausted: " + r.message());
        }
        attempt += 1;
        runtime:sleep(pause);
    }
}

# Kafka records of the old flows (kafka:publish). Off until the old application stops.
configurable commons:AuditSettings kafkaRecords = {};

final commons:RecordPublisher recordPublisher = new (kafkaRecords);

isolated function publishRecord(string topic, string key, json value) {
    if topic != "" && topic == kafkaRecords.errorTopic {
        recordPublisher.failure(key, value);
    } else {
        recordPublisher.audit(key, value);
    }
}

// ------------------------------------------------------------------ HTTP requests (http:request)

isolated function dwPath(string path, json uriParams, json queryParams) returns string {
    string p = path;
    if uriParams is map<json> {
        foreach [string, json] [k, v] in uriParams.entries() {
            string|error enc = url:encode(dwText(v), "UTF-8");
            p = dwText(dwReplace(p, "{" + k + "}", enc is string ? enc : dwText(v)));
        }
    }
    string[] q = [];
    if queryParams is map<json> {
        foreach [string, json] [k, v] in queryParams.entries() {
            json[] values = v is json[] ? v : [v];
            foreach json one in values {
                if one is () {
                    continue;
                }
                string|error ek = url:encode(k, "UTF-8");
                string|error ev = url:encode(dwText(one), "UTF-8");
                q.push((ek is string ? ek : k) + "=" + (ev is string ? ev : dwText(one)));
            }
        }
    }
    if !p.startsWith("/") {
        p = "/" + p;
    }
    return q.length() == 0 ? p : p + (p.includes("?") ? "&" : "?") + string:'join("&", ...q);
}

isolated function dwRequest(string method, json body, json headers, string mime) returns http:Request {
    http:Request req = new;
    string? contentType = ();
    if headers is map<json> {
        foreach [string, json] [k, v] in headers.entries() {
            if v is () {
                continue;
            }
            if k.toLowerAscii() == "content-type" {
                contentType = dwText(v);
                continue;
            }
            req.setHeader(k, dwText(v));
        }
    }
    if method == "GET" || method == "HEAD" || method == "OPTIONS" || body is () {
        return req;
    }
    if mime.includes("x-www-form-urlencoded") && body is map<json> {
        string[] pairs = [];
        foreach [string, json] [k, v] in body.entries() {
            string|error ek = url:encode(k, "UTF-8");
            string|error ev = url:encode(dwText(v), "UTF-8");
            pairs.push((ek is string ? ek : k) + "=" + (ev is string ? ev : dwText(v)));
        }
        req.setTextPayload(string:'join("&", ...pairs), "application/x-www-form-urlencoded");
    } else if body is string && !mime.includes("json") {
        req.setTextPayload(body);
    } else {
        req.setJsonPayload(body);
    }
    if contentType is string {
        req.setHeader("Content-Type", contentType);
    }
    return req;
}

isolated function inRanges(int code, string spec) returns boolean {
    foreach string part0 in re `,`.split(spec) {
        string part = part0.trim();
        int? dots = part.indexOf("..");
        if dots is int {
            int|error a = int:fromString(part.substring(0, dots));
            int|error b = int:fromString(part.substring(dots + 2));
            if a is int && b is int && code >= a && code <= b {
                return true;
            }
        } else {
            int|error a = int:fromString(part);
            if a is int && a == code {
                return true;
            }
        }
    }
    return false;
}

final readonly & map<string> HTTP_TYPES = {"400": "HTTP:BAD_REQUEST", "401": "HTTP:UNAUTHORIZED", "403": "HTTP:FORBIDDEN",
    "404": "HTTP:NOT_FOUND", "405": "HTTP:METHOD_NOT_ALLOWED", "406": "HTTP:NOT_ACCEPTABLE",
    "415": "HTTP:UNSUPPORTED_MEDIA_TYPE", "429": "HTTP:TOO_MANY_REQUESTS", "500": "HTTP:INTERNAL_SERVER_ERROR",
    "502": "HTTP:BAD_GATEWAY", "503": "HTTP:SERVICE_UNAVAILABLE", "504": "HTTP:GATEWAY_TIMEOUT"};

final readonly & map<string> REASONS = {"400": "bad request", "401": "unauthorized", "403": "forbidden",
    "404": "not found", "405": "method not allowed", "406": "not acceptable", "409": "conflict",
    "415": "unsupported media type", "429": "too many requests", "500": "internal server error",
    "502": "bad gateway", "503": "service unavailable", "504": "gateway timeout"};

isolated function dwHttpResult(Event e, http:Response|error r, string method, string url, string success) returns error? {
    if r is error {
        string t = r is http:IdleTimeoutError ? "HTTP:TIMEOUT" : "HTTP:CONNECTIVITY";
        return muleError(t, "HTTP " + method + " on resource '" + url + "' failed: " + r.message() + ".");
    }
    int code = r.statusCode;
    string ct = r.getContentType();
    json body = ();
    if ct.includes("json") {
        json|error j = r.getJsonPayload();
        body = j is json ? j : ();
    } else {
        string|error t = r.getTextPayload();
        body = t is string && t != "" ? t : ();
    }
    map<json> headers = {};
    foreach string h in r.getHeaderNames() {
        string|error v = r.getHeader(h);
        if v is string {
            headers[h.toLowerAscii()] = v;
        }
    }
    map<json> attrs = {statusCode: code, reasonPhrase: r.reasonPhrase, headers};
    if !inRanges(code, success) {
        string reason = REASONS[code.toString()] ?: r.reasonPhrase.toLowerAscii();
        string errorType = HTTP_TYPES[code.toString()] ?: (code >= 500 ? "HTTP:INTERNAL_SERVER_ERROR" : "HTTP:BAD_REQUEST");
        return muleError(errorType, "HTTP " + method + " on resource '" + url + "' failed: " + reason + " (" + code.toString() + ").",
            body, attrs);
    }
    e.payload = body.cloneReadOnly();
    e.attributes = attrs.cloneReadOnly();
    e.mime = ct.includes("json") ? "application/json" : ct == "" ? "application/java" : ct;
}

// ------------------------------------------------------------------ the operation (http:listener + APIkit)

isolated function newEvent(http:Request request, map<string> uriParams, byte[]? body = ()) returns Event {
    string ct = request.getContentType();
    json payload = ();
    if body is byte[] {
        // the body was read once already (APIkit checks): parse those same bytes
        string|error t = string:fromBytes(body);
        if t is string && t != "" {
            if ct.includes("json") {
                json|error j = t.fromJsonString();
                payload = j is json ? j : ();
            } else {
                payload = t;
            }
        }
    } else if ct.includes("json") {
        json|error j = request.getJsonPayload();
        payload = j is json ? j : ();
    } else {
        string|error t = request.getTextPayload();
        payload = t is string && t != "" ? t : ();
    }
    map<json> headers = {};
    foreach string h in request.getHeaderNames() {
        string|error v = request.getHeader(h);
        if v is string {
            headers[h.toLowerAscii()] = v;
        }
    }
    map<json> query = {};
    foreach [string, string[]] [k, vs] in request.getQueryParams().entries() {
        query[k] = vs.length() > 0 ? vs[0] : "";
    }
    string raw = request.rawPath;
    int? qi = raw.indexOf("?");
    map<json> attrs = {
        headers,
        queryParams: query,
        uriParams: uriParams,
        method: request.method,
        requestPath: qi is int ? raw.substring(0, qi) : raw,
        rawRequestPath: qi is int ? raw.substring(0, qi) : raw,
        requestUri: raw,
        queryString: qi is int ? raw.substring(qi + 1) : "",
        listenerPath: basePath + "/*",
        scheme: "http",
        version: "HTTP/1.1"
    };
    return {
        payload: payload.cloneReadOnly(),
        attributes: attrs.cloneReadOnly(),
        mime: ct.includes("json") ? "application/json" : ct == "" ? "application/java" : ct,
        correlationId: commons:correlationIdOf(request)
    };
}

isolated function operation(http:Request request, map<string> uriParams, isolated function (Event) returns error? flow,
        isolated function (Event, error) returns error? onError,
        isolated function (Event, boolean) returns http:Response|error respond, json spec = ()) returns http:Response {
    byte[] raw = [];
    if spec !is () {
        byte[]|error rb = request.getBinaryPayload();
        if rb is byte[] {
            raw = rb;
        }
    }
    Event e = newEvent(request, uriParams, spec !is () ? raw : ());
    Event|MuleError checked = apikitCheck(request, e, raw, spec);
    error? r = ();
    if checked is MuleError {
        r = checked;
    } else {
        e = checked;
        r = trap flow(e);
    }
    boolean failed = false;
    if r is error {
        MuleError me = asMule(r);
        e.err = errView(me);
        error? handled = trap onError(e, me);
        if handled is error {
            failed = true;
            MuleError last = asMule(handled);
            e.err = errView(last);
            if last.detail().errorType == "MULE:NOT_PORTED" {
                log:printWarn("Not migrated yet", correlationId = e.correlationId, reason = last.message());
                return commons:errorResponse(commons:envelopeOf(commons:NOT_IMPLEMENTED, last.message(), e.correlationId));
            }
            log:printError("Operation failed", correlationId = e.correlationId, errorType = last.detail().errorType,
                reason = last.message());
        }
    }
    http:Response|error resp = trap respond(e, failed);
    if resp is http:Response {
        return resp;
    }
    http:Response fallback = new;
    fallback.statusCode = 500;
    fallback.setTextPayload(resp.message());
    return fallback;
}

isolated function writeResponse(Event e, json status, json headers, json body) returns http:Response {
    http:Response res = new;
    int code = 200;
    if status is int {
        code = status;
    } else if status is string {
        int|error c = int:fromString(status);
        code = c is int ? c : 200;
    } else if status is decimal {
        code = <int>status;
    }
    res.statusCode = code;
    if body is string && !e.mime.includes("json") {
        res.setTextPayload(body, e.mime.startsWith("text/") ? e.mime : "text/plain");
    } else if body !is () || e.mime.includes("json") {
        res.setJsonPayload(body);
    }
    if headers is map<json> {
        foreach [string, json] [k, v] in headers.entries() {
            if v !is () {
                res.setHeader(k, dwText(v));
            }
        }
    }
    res.setHeader(commons:CORRELATION_HEADER, e.correlationId);
    return res;
}

// ---------------------------------------------------------------- APIkit
// The old APIkit router checked every request against the API specification before any flow ran:
// unknown resource (APIKIT:NOT_FOUND), wrong method (APIKIT:METHOD_NOT_ALLOWED), parameters, headers
// and body (APIKIT:BAD_REQUEST), content type (APIKIT:UNSUPPORTED_MEDIA_TYPE). The same checks run
// here, from the specification in the upload, and their errors go through the ported error handler.

isolated function apikitScalar(string v, json s) returns string? {
    if s !is map<json> {
        return ();
    }
    string t = s["t"] is string ? <string>s["t"] : "string";
    if t == "integer" && !re `^-?[0-9]+$`.isFullMatch(v) {
        return v + " is not a valid integer value";
    }
    if t == "number" && !re `^-?[0-9]+(\.[0-9]+)?([eE][-+]?[0-9]+)?$`.isFullMatch(v) {
        return v + " is not a valid number value";
    }
    if t == "boolean" && v != "true" && v != "false" {
        return v + " is not a valid boolean value";
    }
    if t == "date" && !re `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`.isFullMatch(v) {
        return v + " is not a valid date-only value";
    }
    json en = s["enum"];
    if en is json[] && en.length() > 0 {
        boolean ok = false;
        foreach json x in en {
            if dwText(x) == v {
                ok = true;
            }
        }
        if !ok {
            return v + " is not one of the allowed values " + en.toJsonString();
        }
    }
    string? bad = apikitFacets(v, s);
    if bad is string {
        return bad;
    }
    if t == "integer" || t == "number" {
        decimal|error d = decimal:fromString(v);
        if d is decimal {
            string? r = apikitRange(d, s);
            if r is string {
                return r;
            }
        }
    }
    return ();
}

isolated function apikitFacets(string v, map<json> s) returns string? {
    json p = s["pattern"];
    if p is string {
        regexp:RegExp|error r = regexp:fromString(p);
        if r is regexp:RegExp && r.find(v) is () {
            return v + " does not match the pattern " + p;
        }
    }
    json minL = s["minL"];
    if minL is int && v.length() < minL {
        return "length of " + v + " is less than " + minL.toString();
    }
    json maxL = s["maxL"];
    if maxL is int && v.length() > maxL {
        return "length of " + v + " is greater than " + maxL.toString();
    }
    return ();
}

isolated function apikitNum(json x) returns decimal? {
    if x is int {
        return <decimal>x;
    }
    if x is decimal {
        return x;
    }
    if x is float {
        decimal|error d = decimal:fromString(x.toString());
        return d is decimal ? d : ();
    }
    return ();
}

isolated function apikitRange(decimal d, map<json> s) returns string? {
    decimal? mn = apikitNum(s["min"]);
    if mn is decimal && d < mn {
        return d.toString() + " is less than the minimum " + mn.toString();
    }
    decimal? mx = apikitNum(s["max"]);
    if mx is decimal && d > mx {
        return d.toString() + " is greater than the maximum " + mx.toString();
    }
    decimal? xmn = apikitNum(s["xmin"]);
    if xmn is decimal && d <= xmn {
        return d.toString() + " is not greater than " + xmn.toString();
    }
    decimal? xmx = apikitNum(s["xmax"]);
    if xmx is decimal && d >= xmx {
        return d.toString() + " is not less than " + xmx.toString();
    }
    return ();
}

isolated function apikitTypeName(json v) returns string {
    if v is () {
        return "null";
    } else if v is string {
        return "string";
    } else if v is boolean {
        return "boolean";
    } else if v is int {
        return "integer";
    } else if v is decimal|float {
        return "number";
    } else if v is json[] {
        return "array";
    }
    return "object";
}

# The first way `v` does not fit the schema `s`, in the style of the old validator; () when it fits.
isolated function apikitJson(json v, json s, string at) returns string? {
    if s !is map<json> {
        return ();
    }
    json alts = s["any"];
    if alts is json[] && alts.length() > 0 {
        foreach json a in alts {
            if apikitJson(v, a, at) is () {
                return ();
            }
        }
        return at + ": does not match any of the allowed types";
    }
    string t = s["t"] is string ? <string>s["t"] : "any";
    if v is () {
        if t == "any" || t == "null" || s["nullable"] == true {
            return ();
        }
        return at + ": expected type " + t + " but found null";
    }
    string found = apikitTypeName(v);
    match t {
        "string"|"date"|"datetime"|"file" => {
            if v !is string {
                return at + ": expected type string but found " + found;
            }
            json en = s["enum"];
            if en is json[] && en.length() > 0 && en.indexOf(v) is () {
                return at + ": " + v + " is not one of the allowed values " + en.toJsonString();
            }
            return apikitFacets(v, s) is string ? at + ": " + <string>apikitFacets(v, s) : ();
        }
        "integer" => {
            decimal? d = apikitNum(v);
            if d is () || d != d.floor() {
                return at + ": expected type integer but found " + found;
            }
            string? r = apikitRange(d, s);
            return r is string ? at + ": " + r : ();
        }
        "number" => {
            decimal? d = apikitNum(v);
            if d is () {
                return at + ": expected type number but found " + found;
            }
            string? r = apikitRange(d, s);
            return r is string ? at + ": " + r : ();
        }
        "boolean" => {
            return v is boolean ? () : at + ": expected type boolean but found " + found;
        }
        "null" => {
            return at + ": expected type null but found " + found;
        }
        "array" => {
            if v !is json[] {
                return at + ": expected type array but found " + found;
            }
            json mn = s["minI"];
            if mn is int && v.length() < mn {
                return at + ": array has fewer than " + mn.toString() + " items";
            }
            json mx = s["maxI"];
            if mx is int && v.length() > mx {
                return at + ": array has more than " + mx.toString() + " items";
            }
            foreach int i in 0 ..< v.length() {
                string? bad = apikitJson(v[i], s["items"], at + "[" + i.toString() + "]");
                if bad is string {
                    return bad;
                }
            }
            return ();
        }
        "object" => {
            if v !is map<json> {
                return at + ": expected type object but found " + found;
            }
            json req = s["req"];
            if req is json[] {
                foreach json r in req {
                    if r is string && !v.hasKey(r) {
                        return at + ": missing required field \"" + r + "\"";
                    }
                }
            }
            json props = s["props"];
            if props is map<json> {
                foreach [string, json] [k, ps] in props.entries() {
                    if v.hasKey(k) {
                        string? bad = apikitJson(v[k], ps, at == "$" ? k : at + "." + k);
                        if bad is string {
                            return bad;
                        }
                    }
                }
                if s["addl"] == false {
                    foreach string k in v.keys() {
                        if !props.hasKey(k) {
                            return at + ": unexpected field \"" + k + "\"";
                        }
                    }
                }
            }
            return ();
        }
    }
    return ();
}

isolated function apikitCopy(json v) returns map<json> {
    map<json> out = {};
    if v is map<json> {
        foreach [string, json] [k, x] in v.entries() {
            out[k] = x;
        }
    }
    return out;
}

isolated function apikitBadRequest(string description) returns MuleError
    => muleError("APIKIT:BAD_REQUEST", description);

# The checks of one operation. Returns the event with the defaults APIkit filled in, or its error.
isolated function apikitCheck(http:Request request, Event e, byte[] raw, json spec) returns Event|MuleError {
    if spec !is map<json> {
        return e;
    }
    // fresh maps: clone() of a read-only value would return the same read-only value
    map<json> attrs = apikitCopy(e.attributes);
    map<json> uri = apikitCopy(attrs["uriParams"]);
    map<json> query = apikitCopy(attrs["queryParams"]);
    map<json> headers = apikitCopy(attrs["headers"]);
    json ups = spec["u"];
    if ups is json[] {
        foreach json p in ups {
            if p is map<json> && p["n"] is string {
                string n = <string>p["n"];
                json v = uri[n];
                if v is string {
                    string? bad = apikitScalar(v, p["s"]);
                    if bad is string {
                        return apikitBadRequest("Invalid value '" + v + "' for uri parameter " + n + ". " + bad);
                    }
                }
            }
        }
    }
    json qs = spec["q"];
    if qs is json[] {
        foreach json p in qs {
            if p !is map<json> || p["n"] !is string {
                continue;
            }
            string n = <string>p["n"];
            json v = query[n];
            if v is () {
                if p.hasKey("d") {
                    query[n] = dwText(p["d"]);
                } else if p["r"] == true {
                    return apikitBadRequest("Required query parameter " + n + " not specified");
                }
                continue;
            }
            string? bad = apikitScalar(dwText(v), p["s"]);
            if bad is string {
                return apikitBadRequest("Invalid value '" + dwText(v) + "' for query parameter " + n + ". " + bad);
            }
        }
    }
    json hs = spec["h"];
    if hs is json[] {
        foreach json p in hs {
            if p !is map<json> || p["n"] !is string {
                continue;
            }
            string n = <string>p["n"];
            json v = headers[n.toLowerAscii()];
            if v is () {
                if p.hasKey("d") {
                    headers[n.toLowerAscii()] = dwText(p["d"]);
                } else if p["r"] == true {
                    return apikitBadRequest("Required header " + n + " not specified");
                }
                continue;
            }
            string? bad = apikitScalar(dwText(v), p["s"]);
            if bad is string {
                return apikitBadRequest("Invalid value '" + dwText(v) + "' for header " + n + ". " + bad);
            }
        }
    }
    json b = spec["b"];
    if b is map<json> {
        string ct = request.getContentType().toLowerAscii();
        int? semi = ct.indexOf(";");
        string base = (semi is int ? ct.substring(0, semi) : ct).trim();
        boolean present = raw.length() > 0;
        if present || b["r"] == true {
            json types = b["types"];
            boolean known = false;
            if types is json[] {
                foreach json t in types {
                    if t is string && (t.toLowerAscii() == base || t == "*/*") {
                        known = true;
                    }
                }
            }
            if !known {
                return muleError("APIKIT:UNSUPPORTED_MEDIA_TYPE", "Unsupported media type");
            }
            if base.includes("json") && b["s"] is map<json> {
                json body = ();
                if present {
                    string|error text = string:fromBytes(raw);
                    json|error parsed = text is string ? text.fromJsonString() : text;
                    if parsed is error {
                        return apikitBadRequest("Error validating JSON. Error: - Invalid json: " + parsed.message());
                    }
                    body = parsed;
                }
                string? bad = apikitJson(body, b["s"], "$");
                if bad is string {
                    return apikitBadRequest("Error validating JSON. Error: - " + bad);
                }
            }
        }
    }
    attrs["queryParams"] = query;
    attrs["headers"] = headers;
    e.attributes = attrs.cloneReadOnly();
    return e;
}

isolated function apikitRouteMatches(string tpl, string path) returns boolean {
    string[] a = re `/`.split(tpl.substring(tpl.startsWith("/") ? 1 : 0));
    string[] b = re `/`.split(path.substring(path.startsWith("/") ? 1 : 0));
    if a.length() != b.length() {
        return false;
    }
    foreach int i in 0 ..< a.length() {
        if a[i] != "{}" && a[i] != b[i] {
            return false;
        }
    }
    return true;
}

# A request no operation took: APIkit answered APIKIT:NOT_FOUND, or APIKIT:METHOD_NOT_ALLOWED when
# the resource exists with other methods; the old error handler decided the answer.
isolated function apikitUnmatched(http:Request request, string[] path, readonly & string[] routes,
        isolated function (Event, error) returns error? onError,
        isolated function (Event, boolean) returns http:Response|error respond) returns http:Response {
    string rel = "/" + string:'join("/", ...path);
    boolean exists = false;
    foreach string r in routes {
        int? sp = r.indexOf(" ");
        if sp is int && apikitRouteMatches(r.substring(sp + 1), rel) {
            exists = true;
        }
    }
    MuleError me = exists
        ? muleError("APIKIT:METHOD_NOT_ALLOWED", "HTTP Method " + request.method + " not allowed for : " + rel)
        : muleError("APIKIT:NOT_FOUND", "Resource not found");
    Event e = newEvent(request, {});
    e.err = errView(me);
    error? handled = trap onError(e, me);
    boolean failed = handled is error;
    if handled is error {
        e.err = errView(asMule(handled));
    }
    http:Response|error resp = trap respond(e, failed);
    if resp is http:Response {
        return resp;
    }
    http:Response fallback = new;
    fallback.statusCode = 500;
    fallback.setTextPayload(resp.message());
    return fallback;
}

// ---- ee:set-attributes and requests to a full URL (http:request url="...")

isolated function dwAttrs(json v) returns readonly & map<json> {
    map<json> out = {};
    if v is map<json> {
        foreach [string, json] [k, x] in v.entries() {
            out[k] = x;
        }
    }
    return out.cloneReadOnly();
}

# scheme://host[:port] and the rest (path and query) of a full URL.
isolated function dwSplitUrl(string full) returns [string, string] {
    int? s = full.indexOf("://");
    int startAt = s is int ? s + 3 : 0;
    int? slash = full.indexOf("/", startAt);
    if slash is () {
        return [full, "/"];
    }
    return [full.substring(0, slash), full.substring(slash)];
}

isolated function dwUrlClient(string base) returns http:Client|error => new (base, {timeout: 60});
