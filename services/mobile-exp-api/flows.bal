            log:printDebug(dwText(check dwEval(dw30, e)), correlationId = e.correlationId);
        } else {
            log:printError(dwText(<readonly & json>(propText("Payload ready for Kafka: ") + dwText(check dwEval(dw31, e)))), correlationId = e.correlationId);
            readonly & json v32 = check dwEval(dw32, e);
