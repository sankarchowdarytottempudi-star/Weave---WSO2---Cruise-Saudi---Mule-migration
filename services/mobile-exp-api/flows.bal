                } else {
                    // kafka:publish to ${kafka.errorTopic}: switched off until the old application stops (audit settings).
                    publishRecord(dwText(<readonly & json>propText("${kafka.errorTopic}")), dwText(check dwEval(dw36, e)), e.payload);
                }
            } else {
                // kafka:publish to ${kafka.errorTopic}: switched off until the old application stops (audit settings).
                publishRecord(dwText(<readonly & json>propText("${kafka.errorTopic}")), dwText(check dwEval(dw37, e)), e.payload);
